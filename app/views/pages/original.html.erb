<% content_for :title, "الأصلي مقابل المقلد — ألمنيوم مزايا" %>
<% content_for :description, "كيف تفرّق بين سلّم مزايا الأصلي وأي تقليد: أربع علامات لا تقبل التزوير." %>
<% content_for :nav_active, "products" %>

<section style="background:#0D1744;padding:170px 48px 80px;position:relative;overflow:hidden">
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse 55% 65% at 20% 40%,rgba(185,198,242,.14),transparent 70%)"></div>
  <div style="position:relative;max-width:1280px;margin:0 auto">
    <div data-reveal class="kicker">الأصلي في مواجهة المقلد</div>
    <h1 data-reveal style="margin:0 0 16px;color:#fff;font-size:clamp(40px,4.5vw,64px);font-weight:900">السوق مليء بالمقلد.<br>هكذا تعرف الأصل.</h1>
    <p data-reveal style="margin:0;color:rgba(255,255,255,.75);font-size:19px;line-height:1.8;max-width:640px">التقليد لا يسرق الاسم فقط — يسرق السلامة. اسحب المقارنة وشاهد الفرق بعينك.</p>
  </div>
</section>

<section style="padding:90px 48px 40px;background:#F4F5F7">
  <div style="max-width:1180px;margin:0 auto">
    <div data-reveal id="cmp" style="position:relative;height:520px;border-radius:26px;overflow:hidden;box-shadow:0 24px 64px rgba(25,44,123,.16);user-select:none">
      <div style="position:absolute;inset:0;filter:grayscale(.85) contrast(.82) brightness(.8)"><img src="/assets/cat-carts.jpg" alt="المنتج المقلد" class="cover" loading="lazy"></div>
      <div id="cmpReal" style="position:absolute;inset:0;clip-path:inset(0 0 0 50%)"><img src="/assets/hero.jpg" alt="المنتج الأصلي" class="cover" loading="lazy"></div>
      <div style="position:absolute;top:22px;right:24px;background:#192C7B;color:#fff;font-size:14px;font-weight:800;border-radius:999px;padding:9px 20px;pointer-events:none;box-shadow:0 6px 18px rgba(0,0,0,.3)">✓ الأصلي</div>
      <div style="position:absolute;top:22px;left:24px;background:rgba(35,38,43,.88);color:#fff;font-size:14px;font-weight:800;border-radius:999px;padding:9px 20px;pointer-events:none">✕ المقلد</div>
      <div id="cmpHandle" style="position:absolute;top:0;bottom:0;left:50%;width:44px;margin-left:-22px;cursor:ew-resize;display:flex;align-items:center;justify-content:center;touch-action:none">
        <div style="position:absolute;top:0;bottom:0;left:50%;width:3px;margin-left:-1.5px;background:#fff;box-shadow:0 0 14px rgba(0,0,0,.45)"></div>
        <div style="position:relative;width:52px;height:52px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 24px rgba(0,0,0,.35);color:#192C7B;font-size:18px;font-weight:900">⇄</div>
      </div>
    </div>
    <div data-reveal style="text-align:center;color:#686B70;font-size:14px;font-weight:600;margin-top:18px">اسحب المقبض يمينًا ويسارًا للمقارنة</div>
  </div>
</section>

<section style="padding:70px 48px;background:#F4F5F7">
  <div style="max-width:1280px;margin:0 auto">
    <div data-reveal style="margin-bottom:44px">
      <h2 style="margin:0;color:#192C7B;font-size:38px;font-weight:900">أربع علامات لا تقبل التزوير</h2>
    </div>
    <div class="grid-2" style="display:grid;grid-template-columns:repeat(2,1fr);gap:22px">
      
      <div data-reveal style="background:#fff;border-radius:20px;padding:30px 32px;display:flex;gap:20px;align-items:start">
        <div style="width:52px;height:52px;border-radius:14px;background:#192C7B;color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:900;flex-shrink:0">١</div>
        <div>
          <h3 style="margin:0 0 8px;color:#192C7B;font-size:20px;font-weight:800">الاسم المحفور</h3>
          <p style="margin:0;color:#686B70;font-size:15px;line-height:1.8">شعار مزايا محفور بالبثق في جسم القائم نفسه — ليس ملصقًا يُنزع.</p>
        </div>
      </div>
      <div data-reveal style="background:#fff;border-radius:20px;padding:30px 32px;display:flex;gap:20px;align-items:start">
        <div style="width:52px;height:52px;border-radius:14px;background:#192C7B;color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:900;flex-shrink:0">٢</div>
        <div>
          <h3 style="margin:0 0 8px;color:#192C7B;font-size:20px;font-weight:800">ختم الجودة</h3>
          <p style="margin:0;color:#686B70;font-size:15px;line-height:1.8">ختم دفعة الإنتاج وتاريخها على كل منتج، يمكن التحقق منه لدى المصنع.</p>
        </div>
      </div>
      <div data-reveal style="background:#fff;border-radius:20px;padding:30px 32px;display:flex;gap:20px;align-items:start">
        <div style="width:52px;height:52px;border-radius:14px;background:#192C7B;color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:900;flex-shrink:0">٣</div>
        <div>
          <h3 style="margin:0 0 8px;color:#192C7B;font-size:20px;font-weight:800">الوزن والسماكة</h3>
          <p style="margin:0;color:#686B70;font-size:15px;line-height:1.8">سماكات مبثوقة محسوبة — المقلد أخف وأرق ويُحس فرقه باليد.</p>
        </div>
      </div>
      <div data-reveal style="background:#fff;border-radius:20px;padding:30px 32px;display:flex;gap:20px;align-items:start">
        <div style="width:52px;height:52px;border-radius:14px;background:#192C7B;color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:900;flex-shrink:0">٤</div>
        <div>
          <h3 style="margin:0 0 8px;color:#192C7B;font-size:20px;font-weight:800">تشطيب الخامة</h3>
          <p style="margin:0;color:#686B70;font-size:15px;line-height:1.8">لمعان أكسدة موحد بدون بقع أو خدوش تصنيع.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section style="padding:30px 48px 90px;background:#F4F5F7">
  <div style="max-width:1280px;margin:0 auto">
    <div data-reveal style="background:#0D1744;border-radius:26px;padding:56px 60px">
      <h2 style="margin:0 0 32px;color:#fff;font-size:32px;font-weight:900">ما الذي تخسره مع المقلد؟</h2>
      <div class="grid-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:28px">
        
        <div>
          <div style="color:#B9C6F2;font-size:19px;font-weight:800;margin-bottom:8px">السلامة أولًا</div>
          <div style="color:rgba(255,255,255,.7);font-size:15px;line-height:1.8">درجات تنحني ومفاصل تنهار تحت الحمل — إصابات حقيقية في مواقع العمل.</div>
        </div>
        <div>
          <div style="color:#B9C6F2;font-size:19px;font-weight:800;margin-bottom:8px">عمر أقصر</div>
          <div style="color:rgba(255,255,255,.7);font-size:15px;line-height:1.8">خامة منخفضة النقاء تتشقق وتتأكسد خلال أشهر بدل سنوات.</div>
        </div>
        <div>
          <div style="color:#B9C6F2;font-size:19px;font-weight:800;margin-bottom:8px">بدون ضمان</div>
          <div style="color:rgba(255,255,255,.7);font-size:15px;line-height:1.8">لا جهة تتحمل المسؤولية — لا صيانة، لا استبدال، لا مساءلة.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<section style="padding:0 48px 100px;background:#F4F5F7">
  <div data-reveal class="cta-band" style="padding:56px 64px">
    <div>
      <h2 style="margin:0 0 10px;color:#fff;font-size:30px;font-weight:900">عندك شك في منتج؟</h2>
      <p style="margin:0;color:rgba(255,255,255,.75);font-size:16.5px">أرسل لنا صورة على واتساب ونتأكد معك من الأصالة مجانًا.</p>
    </div>
    <a data-wa href="#" class="btn-wa">تأكد من الأصالة الآن</a>
  </div>
</section>

<% content_for :page_script do %>
<script>
// before/after comparison slider
(function () {
  var box = document.getElementById('cmp');
  var real = document.getElementById('cmpReal');
  var handle = document.getElementById('cmpHandle');
  if (!box || !real || !handle) return;
  var set = function (pct) {
    pct = Math.min(Math.max(pct, 4), 96);
    real.style.clipPath = 'inset(0 0 0 ' + pct + '%)';
    handle.style.left = pct + '%';
  };
  handle.addEventListener('pointerdown', function (e) {
    e.preventDefault();
    var r = box.getBoundingClientRect();
    var move = function (ev) { set(((ev.clientX - r.left) / r.width) * 100); };
    var up = function () { removeEventListener('pointermove', move); removeEventListener('pointerup', up); };
    addEventListener('pointermove', move); addEventListener('pointerup', up);
  });
})();
</script>
<% end %>
