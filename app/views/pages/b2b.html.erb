<% content_for :title, t("b2b.title") %>
<% content_for :description, t("b2b.description") %>
<% content_for :nav_active, "b2b" %>

<style>
/* 5 cards: 3 on the first row, 2 wider on the second */
.grid-32{display:grid;grid-template-columns:repeat(6,1fr);gap:22px}
.grid-32>*{grid-column:span 2}
.grid-32>*:nth-child(n+4){grid-column:span 3}
@media(max-width:960px){.grid-32{grid-template-columns:1fr}.grid-32>*{grid-column:auto}}
</style>

<%# 01 — Hero %>
<%= render "shared/page_hero",
      label: t("b2b.hero.label"), h1: t("b2b.hero.h1"), desc: t("b2b.hero.desc"),
      image: "/assets/proj-tower.jpg",
      primary: [ t("common.request_quote"), rfq_path ],
      secondary: [ t("b2b.hero.secondary"), download_path("technical-catalog"), "technical-catalog" ] %>

<%# 02 — Business solutions: the five categories, B2B wording %>
<section id="solutions" class="section-pad bg-soft">
  <div class="wrap">
    <%= render "shared/section_head", label: t("b2b.solutions.label"), h2: t("b2b.solutions.h2"), desc: t("b2b.solutions.desc"), center: true %>
    <div class="grid-32">
      <% @categories.each do |c| %>
      <a href="<%= product_category_path(c[:slug]) %>" data-reveal class="cat-card card-hover">
        <div class="cat-media"><img src="<%= c[:image] %>" alt="<%= c[:name] %>" loading="lazy"></div>
        <div class="cat-body">
          <div class="product-cat" dir="ltr" style="text-align:end"><%= c[:en] %></div>
          <h3><%= c[:name] %></h3>
          <p><%= c[:b2b] %></p>
          <span class="card-link"><%= t("common.explore_solutions") %> ←</span>
        </div>
      </a>
      <% end %>
    </div>
  </div>
</section>

<%# 03 — Custom manufacturing %>
<section id="custom" class="section-pad bg-dark" style="position:relative;overflow:hidden">
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse 50% 60% at 15% 50%,rgba(185,198,242,.14),transparent 70%)"></div>
  <div class="wrap grid-2" style="position:relative;align-items:center;gap:60px">
    <div data-reveal>
      <div class="kicker"><%= t("b2b.custom.label") %></div>
      <h2 style="margin:0 0 18px;color:#fff;font-size:42px;font-weight:900;line-height:1.25"><%= t("b2b.custom.h2") %></h2>
      <p style="margin:0 0 12px;color:rgba(255,255,255,.78);font-size:17.5px;line-height:1.8"><%= t("b2b.custom.desc") %></p>
      <p style="margin:0 0 32px;color:rgba(255,255,255,.65);font-size:16px;line-height:1.8"><%= t("b2b.custom.desc2") %></p>
      <a href="<%= solutions_path %>" class="btn-white"><%= t("b2b.custom.cta") %></a>
    </div>
    <div data-reveal class="grid-2m" style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
      <% t("b2b.custom.points").each_with_index do |(title, desc), i| %>
      <div class="feature-card dark" style="padding:26px 24px">
        <div style="color:#B9C6F2;font-size:22px;font-weight:900;margin-bottom:8px"><%= num(i + 1) %></div>
        <h3 style="font-size:17.5px"><%= title %></h3>
        <p><%= desc %></p>
      </div>
      <% end %>
    </div>
  </div>
</section>

<%# 04 — Projects %>
<section id="projects" class="section-pad bg-soft">
  <div class="wrap">
    <%= render "shared/section_head", label: t("b2b.projects.label"), h2: t("b2b.projects.h2"), desc: t("b2b.projects.desc"), link: [ t("b2b.projects.cta"), projects_path ] %>
    <div class="grid-32">
      <% @projects.each do |p| %><%= render "shared/project_card", project: p %><% end %>
    </div>
  </div>
</section>

<%# 05 — E-catalog band %>
<section id="catalog" class="section-pad bg-navy" style="position:relative;overflow:hidden">
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse 50% 60% at 85% 50%,rgba(185,198,242,.16),transparent 70%)"></div>
  <div class="wrap grid-2" style="position:relative;align-items:center;gap:60px">
    <div data-reveal style="display:flex;justify-content:center;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:26px;padding:48px 32px">
      <a data-gate="catalog-full" data-gate-title="<%= SiteData::DOWNLOADS["catalog-full"][:title] %>" href="<%= download_path("catalog-full") %>" class="catalog-cover" style="max-width:240px;width:100%;padding:26px;font-size:17px">
        <img src="/assets/logo-white.png" alt="">
        <span><%= SiteData::DOWNLOADS["catalog-full"][:title] %></span>
      </a>
    </div>
    <div data-reveal>
      <div class="kicker"><%= t("b2b.catalog.label") %></div>
      <h2 style="margin:0 0 20px;color:#fff;font-size:42px;font-weight:900;line-height:1.25"><%= t("b2b.catalog.h2") %></h2>
      <p style="margin:0 0 36px;color:rgba(255,255,255,.75);font-size:17.5px;line-height:1.8"><%= t("b2b.catalog.desc") %></p>
      <div style="display:flex;gap:14px;flex-wrap:wrap">
        <a href="<%= catalog_path %>" class="btn-white"><%= t("b2b.catalog.primary") %></a>
        <a data-gate="catalog-full" data-gate-title="<%= SiteData::DOWNLOADS["catalog-full"][:title] %>" href="<%= download_path("catalog-full") %>" class="btn-ghost"><%= t("common.download_catalog") %></a>
      </div>
    </div>
  </div>
</section>

<%# 06 + 07 — RFQ teaser & partnership teaser %>
<section id="next" class="section-pad bg-white">
  <div class="wrap grid-2" style="gap:24px">
    <div data-reveal class="card-hover" style="background:#F4F5F7;border-radius:26px;padding:48px 44px;display:flex;flex-direction:column">
      <div class="kicker-gray"><%= t("b2b.rfq.label") %></div>
      <h2 style="margin:0 0 14px;color:#192C7B;font-size:32px;font-weight:900;line-height:1.3"><%= t("b2b.rfq.h2") %></h2>
      <p style="margin:0 0 30px;color:#686B70;font-size:16px;line-height:1.8;flex:1"><%= t("b2b.rfq.desc") %></p>
      <div><a href="<%= rfq_path %>" class="btn-navy"><%= t("common.request_quote") %></a></div>
    </div>
    <div data-reveal class="card-hover" style="background:#192C7B;border-radius:26px;padding:48px 44px;display:flex;flex-direction:column;position:relative;overflow:hidden">
      <div style="position:absolute;inset:0;background:radial-gradient(ellipse 60% 70% at 85% 15%,rgba(185,198,242,.2),transparent 70%);pointer-events:none"></div>
      <div class="kicker" style="position:relative"><%= t("b2b.partnership.label") %></div>
      <h2 style="position:relative;margin:0 0 14px;color:#fff;font-size:32px;font-weight:900;line-height:1.3"><%= t("b2b.partnership.h2") %></h2>
      <p style="position:relative;margin:0 0 30px;color:rgba(255,255,255,.78);font-size:16px;line-height:1.8;flex:1"><%= t("b2b.partnership.desc") %></p>
      <div style="position:relative"><a href="<%= partners_path %>" class="btn-white"><%= t("b2b.partnership.cta") %></a></div>
    </div>
  </div>
</section>

<%# 08 — Final CTA %>
<%= render "shared/cta_band", bg: "#fff", h2: t("b2b.final.h2"), desc: t("b2b.final.desc"), primary: [ t("common.request_quote"), rfq_path ], secondary: :whatsapp %>
