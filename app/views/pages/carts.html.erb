<% content_for :title, "العربات الصناعية — ألمنيوم مزايا" %>
<% content_for :description, "عربات نقل ألمنيوم بأحمال مختبرة حتى ٧٥٠ كجم لبيئات المستودعات والمصانع ومواقع الإنشاء." %>
<% content_for :nav_active, "products" %>

<section style="position:relative;min-height:64vh;display:flex;align-items:end;background:#0D1744;overflow:hidden">
  <div style="position:absolute;inset:0;animation:heroZoom 2.4s ease-out both"><img src="/assets/cat-carts.jpg" alt="العربات الصناعية" class="cover"></div>
  <div style="position:absolute;inset:0;background:linear-gradient(0deg,rgba(13,23,68,.95),rgba(13,23,68,.4))"></div>
  <div style="position:relative;z-index:2;max-width:1280px;margin:0 auto;width:100%;padding:150px 48px 60px;box-sizing:border-box">
    <div data-reveal class="crumb"><a href="/products">المنتجات</a><span style="color:rgba(255,255,255,.4)">/</span><span>العربات الصناعية</span></div>
    <h1 data-reveal style="margin:0 0 14px;color:#fff;font-size:clamp(40px,4.5vw,60px);font-weight:900">العربات الصناعية</h1>
    <p data-reveal style="margin:0;color:rgba(255,255,255,.8);font-size:18px;line-height:1.8;max-width:560px">منتج التركيز لهذا العام: عربات نقل تتحمل ما لا تتحمله بيئة العمل نفسها.</p>
  </div>
</section>

<section style="background:#192C7B;padding:52px 48px">
  <div class="grid-2m" style="max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:32px;text-align:center">
    <div data-reveal><div style="color:#fff;font-size:34px;font-weight:900"><span data-count="750">0</span> كجم</div><div style="color:rgba(255,255,255,.65);font-size:14px;margin-top:6px">حمولة المنصة القصوى</div></div>
    <div data-reveal style="border-inline-start:1px solid rgba(255,255,255,.15)"><div style="color:#fff;font-size:34px;font-weight:900">٣×</div><div style="color:rgba(255,255,255,.65);font-size:14px;margin-top:6px">أخف من مكافئها الحديدي</div></div>
    <div data-reveal style="border-inline-start:1px solid rgba(255,255,255,.15)"><div style="color:#fff;font-size:34px;font-weight:900">صفر صدأ</div><div style="color:rgba(255,255,255,.65);font-size:14px;margin-top:6px">ألمنيوم لا يتأثر بالرطوبة</div></div>
    <div data-reveal style="border-inline-start:1px solid rgba(255,255,255,.15)"><div style="color:#fff;font-size:34px;font-weight:900"><span data-count="100">0</span>٪</div><div style="color:rgba(255,255,255,.65);font-size:14px;margin-top:6px">فحص عجلات ومفاصل</div></div>
  </div>
</section>

<section style="padding:100px 48px;background:#fff">
  <div style="max-width:1280px;margin:0 auto">
    <div data-reveal style="margin-bottom:48px">
      <div class="kicker-gray">من كل زاوية</div>
      <h2 style="margin:0;color:#192C7B;font-size:40px;font-weight:900">شاهد التفاصيل</h2>
    </div>
    <div class="grid-2m grid-rows-auto" style="display:grid;grid-template-columns:2fr 1fr;grid-template-rows:280px 280px;gap:20px">
      <div data-reveal style="grid-row:span 2;border-radius:22px;overflow:hidden;min-height:280px"><img src="/assets/cat-carts.jpg" alt="زاوية أمامية" class="cover" loading="lazy"></div>
      <div data-reveal style="border-radius:22px;overflow:hidden;min-height:220px"><div class="ph-slot">زاوية جانبية</div></div>
      <div data-reveal style="border-radius:22px;overflow:hidden;min-height:220px"><div class="ph-slot">تفصيلة العجلات</div></div>
    </div>
    <div data-reveal style="margin-top:20px;position:relative;height:420px;border-radius:22px;overflow:hidden;background:#0D1744">
      <div class="ph-slot dark">فيديو من جلسة التصوير</div>
      <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none">
        <div style="width:92px;height:92px;border-radius:50%;background:rgba(255,255,255,.92);display:flex;align-items:center;justify-content:center;box-shadow:0 16px 44px rgba(0,0,0,.4)">
          <div style="width:0;height:0;border-block:16px solid transparent;border-inline-start:26px solid #192C7B;margin-inline-end:-6px"></div>
        </div>
      </div>
      <div style="position:absolute;bottom:22px;inset-inline-start:26px;color:#fff;font-size:15px;font-weight:700;background:rgba(13,23,68,.75);border-radius:999px;padding:10px 20px;pointer-events:none">فيديو اختبار الأحمال — قريبًا من جلسة التصوير</div>
    </div>
  </div>
</section>

<section style="padding:0 48px 100px;background:#fff">
  <div class="grid-3" style="max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:24px">
    
    <div data-reveal style="background:#F4F5F7;border-radius:20px;padding:32px 30px">
      <div style="color:#192C7B;font-size:19px;font-weight:800;margin-bottom:10px">هيكل مبثوق مقوّى</div>
      <p style="margin:0;color:#686B70;font-size:15px;line-height:1.8">قطاعات ألمنيوم مبثوقة بسماكات محسوبة على نقاط الإجهاد، بدون لحامات ضعيفة.</p>
    </div>
    <div data-reveal style="background:#F4F5F7;border-radius:20px;padding:32px 30px">
      <div style="color:#192C7B;font-size:19px;font-weight:800;margin-bottom:10px">عجلات صناعية مختبرة</div>
      <p style="margin:0;color:#686B70;font-size:15px;line-height:1.8">عجلات دوّارة بفرامل قفل، مختبرة على أسطح خرسانية وممرات مستودعات.</p>
    </div>
    <div data-reveal style="background:#F4F5F7;border-radius:20px;padding:32px 30px">
      <div style="color:#192C7B;font-size:19px;font-weight:800;margin-bottom:10px">مقابض مريحة قابلة للطي</div>
      <p style="margin:0;color:#686B70;font-size:15px;line-height:1.8">مقبض بزاوية دفع طبيعية، يُطوى للتخزين في مساحات ضيقة.</p>
    </div>
  </div>
</section>

<section style="padding:0 48px 100px;background:#fff">
  <div data-reveal class="cta-band" style="padding:56px 64px">
    <div>
      <h2 style="margin:0 0 10px;color:#fff;font-size:30px;font-weight:900">جاهز تشوفها في موقعك؟</h2>
      <p style="margin:0;color:rgba(255,255,255,.75);font-size:16.5px">عرض سعر خلال يوم عمل — وتوريد من مخزون محلي.</p>
    </div>
    <a href="/contact" class="btn-white">اطلب عرض سعر</a>
  </div>
</section>
