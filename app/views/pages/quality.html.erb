<% content_for :title, t("quality.title") %>
<% content_for :description, t("quality.description") %>
<% content_for :nav_active, "quality" %>
<style>
  .doc-slot{height:160px;border-radius:14px;overflow:hidden;border:1.5px dashed #C9CDD6;margin-bottom:22px}

</style>

<%# 01 — Hero %>
<%= render "shared/page_hero",
      label: t("quality.hero.label"), h1: t("quality.hero.h1"), desc: t("quality.hero.desc"),
      crumbs: [ [ t("nav.quality_page"), nil ] ],
      primary: [ t("quality.hero.cta"), "#certifications" ], secondary: :whatsapp %>

<%# 02 — Approach %>
<section class="section-pad bg-white">
  <div class="wrap grid-2" style="align-items:center;gap:60px">
    <div data-reveal style="height:420px;border-radius:26px;overflow:hidden;box-shadow:0 24px 60px rgba(25,44,123,.14)"><img src="/assets/cat-ladders.jpg" alt="" class="cover" loading="lazy"></div>
    <div data-reveal>
      <div class="kicker-gray"><%= t("quality.approach.label") %></div>
      <h2 style="margin:0 0 20px;color:#192C7B;font-size:42px;font-weight:900;line-height:1.25"><%= t("quality.approach.h2") %></h2>
      <p style="margin:0;color:#686B70;font-size:17.5px;line-height:1.8"><%= t("quality.approach.desc") %></p>
    </div>
  </div>
</section>

<%# 03 — Certifications %>
<section id="certifications" class="section-pad bg-soft">
  <div class="wrap">
    <%= render "shared/section_head", label: t("quality.certifications.label"), h2: t("quality.certifications.h2"), desc: t("quality.certifications.intro"), center: true %>
    <%# certification key -> the scan it opens in the lightbox (section 06) %>
    <% scan_for = { "iso" => "iso-9001-2019", "sgs" => "sgs-test-report", "saso" => "saso-quality-mark" } %>
    <div class="grid-4 cert-cards">
      <% @certifications.each do |c| %>
      <div data-reveal class="feature-card card-hover">
        <% if c[:image] %>
        <div class="cert-logo"><img src="<%= c[:image] %>" alt="<%= c[:name] %>" loading="lazy"></div>
        <% else %>
        <div class="doc-slot"><div class="ph-slot doc"><%= c[:name] %></div></div>
        <% end %>
        <h3><%= c[:name] %></h3>
        <p style="margin-bottom:18px"><%= c[:desc] %></p>
        <a href="#documents" class="card-link" <% if scan_for[c[:key]] %>data-cert-key="<%= scan_for[c[:key]] %>"<% end %>><%= c[:cta] %> ←</a>
      </div>
      <% end %>
    </div>
  </div>
</section>

<%# 04 — Load testing %>
<section id="load-testing" class="section-pad bg-dark" style="position:relative;overflow:hidden">
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse 50% 60% at 85% 20%,rgba(185,198,242,.14),transparent 70%)"></div>
  <div class="wrap" style="position:relative">
    <%= render "shared/section_head", label: t("quality.load.label"), h2: t("quality.load.h2"), desc: t("quality.load.desc"), dark: true, center: true %>
    <%= render "pages/cert_grid", docs: @load_tests, per_page: 8, live: @live_products %>
  </div>
</section>

<%# 05 — Quality in manufacturing %>
<section class="section-pad bg-soft">
  <div class="wrap">
    <%= render "shared/section_head", label: t("quality.manufacturing.label"), h2: t("quality.manufacturing.h2"), desc: t("quality.manufacturing.desc") %>
    <div class="steps">
      <% @steps.each_with_index do |(title, desc), i| %>
      <div data-reveal class="step card-hover">
        <div class="step-num"><%= num(i + 1) %></div>
        <h3><%= title %></h3>
        <p><%= desc %></p>
      </div>
      <% end %>
    </div>
  </div>
</section>

<%# 06 — Documents (one card per document; paginated client-side, all cards render without JS) %>
<section id="documents" class="section-pad bg-white">
  <div class="wrap">
    <%= render "shared/section_head", label: t("quality.documents.label"), h2: t("quality.documents.h2"), desc: t("quality.documents.desc") %>
    <%= render "pages/cert_grid", docs: @certificate_scans, per_page: 8 %>
  </div>
</section>

<%= render "shared/doc_viewer" %>

<%# 07 — Link to products %>
<section class="section-pad bg-soft" style="padding-bottom:60px">
  <div class="wrap">
    <div data-reveal class="feature-card" style="flex-direction:row;align-items:center;justify-content:space-between;gap:32px;flex-wrap:wrap;padding:48px 56px;border-radius:26px;box-shadow:0 10px 40px rgba(25,44,123,.08)">
      <div style="max-width:680px">
        <div class="kicker-gray"><%= t("quality.products.label") %></div>
        <h2 style="margin:0 0 12px;color:#192C7B;font-size:32px;font-weight:900;line-height:1.3"><%= t("quality.products.h2") %></h2>
        <p style="font-size:16.5px"><%= t("quality.products.desc") %></p>
      </div>
      <a href="<%= products_path %>" class="btn-navy"><%= t("common.explore_products") %></a>
    </div>
  </div>
</section>

<%# 08 — Final CTA %>
<%= render "shared/cta_band",
      label: t("quality.final.label"), h2: t("quality.final.h2"), desc: t("quality.final.desc"),
      primary: [ t("quality.final.cta"), contact_path(dept: "technical") ], secondary: :whatsapp %>
