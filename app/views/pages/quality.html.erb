<% content_for :title, "الجودة والسلامة — ألمنيوم مزايا" %>
<% content_for :description, "اختبارات أحمال موثقة على كل دفعة إنتاج: من بثق الخامة إلى الفحص النهائي قبل الشحن." %>
<% content_for :nav_active, "quality" %>

<section style="background:#0D1744;padding:170px 48px 80px">
  <div style="max-width:1280px;margin:0 auto">
    <div data-reveal class="kicker">الجودة والسلامة</div>
    <h1 data-reveal style="margin:0 0 16px;color:#fff;font-size:clamp(40px,4.5vw,64px);font-weight:900">السلامة ليست وعدًا.<br>إنها إجراء موثق.</h1>
    <p data-reveal style="margin:0;color:rgba(255,255,255,.75);font-size:19px;line-height:1.8;max-width:620px">كل دفعة إنتاج تمر بنفس السلسلة: اختبار خامة، اختبار حمل، فحص نهائي — وأرقامها تُسجل وتُحفظ.</p>
  </div>
</section>

<section style="background:#192C7B;padding:56px 48px">
  <div class="grid-2m" style="max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:32px;text-align:center">
    <div data-reveal><div style="color:#fff;font-size:34px;font-weight:900"><span data-count="150">0</span> كجم</div><div style="color:rgba(255,255,255,.65);font-size:14px;margin-top:6px">حمل اختبار كل درجة سلم</div></div>
    <div data-reveal style="border-inline-start:1px solid rgba(255,255,255,.15)"><div style="color:#fff;font-size:34px;font-weight:900"><span data-count="750">0</span> كجم</div><div style="color:rgba(255,255,255,.65);font-size:14px;margin-top:6px">حمل اختبار منصات السقالات</div></div>
    <div data-reveal style="border-inline-start:1px solid rgba(255,255,255,.15)"><div style="color:#fff;font-size:34px;font-weight:900"><span data-count="1000">0</span></div><div style="color:rgba(255,255,255,.65);font-size:14px;margin-top:6px">دورة فتح/إغلاق للمفاصل</div></div>
    <div data-reveal style="border-inline-start:1px solid rgba(255,255,255,.15)"><div style="color:#fff;font-size:34px;font-weight:900"><span data-count="100">0</span>٪</div><div style="color:rgba(255,255,255,.65);font-size:14px;margin-top:6px">فحص بصري قبل الشحن</div></div>
  </div>
</section>

<section style="padding:100px 48px;background:#fff">
  <div style="max-width:1280px;margin:0 auto">
    <div data-reveal style="text-align:center;margin-bottom:60px">
      <div class="kicker-gray">من الخامة إلى الشحنة</div>
      <h2 style="margin:0;color:#192C7B;font-size:42px;font-weight:900">أربع محطات، لا استثناءات</h2>
    </div>
    <div class="grid-2m" style="display:grid;grid-template-columns:repeat(4,1fr);gap:22px">
      
      <div data-reveal style="background:#F4F5F7;border-radius:20px;overflow:hidden">
        <div style="height:170px"><div class="ph-slot">البثق</div></div>
        <div style="padding:24px 24px 28px">
          <div style="color:#B9C6F2;font-size:22px;font-weight:900;margin-bottom:6px">٠١</div>
          <h3 style="margin:0 0 8px;color:#192C7B;font-size:19px;font-weight:800">بثق الخامة</h3>
          <p style="margin:0;color:#686B70;font-size:14px;line-height:1.75">قطاعات تُبثق من سبائك عالية النقاء بسماكات محسوبة.</p>
        </div>
      </div>
      <div data-reveal style="background:#F4F5F7;border-radius:20px;overflow:hidden">
        <div style="height:170px"><div class="ph-slot">التجميع</div></div>
        <div style="padding:24px 24px 28px">
          <div style="color:#B9C6F2;font-size:22px;font-weight:900;margin-bottom:6px">٠٢</div>
          <h3 style="margin:0 0 8px;color:#192C7B;font-size:19px;font-weight:800">التجميع</h3>
          <p style="margin:0;color:#686B70;font-size:14px;line-height:1.75">تعاشق ميكانيكي بدون لحامات ضعيفة، بمفاصل مختبرة.</p>
        </div>
      </div>
      <div data-reveal style="background:#F4F5F7;border-radius:20px;overflow:hidden">
        <div style="height:170px"><div class="ph-slot">الاختبار</div></div>
        <div style="padding:24px 24px 28px">
          <div style="color:#B9C6F2;font-size:22px;font-weight:900;margin-bottom:6px">٠٣</div>
          <h3 style="margin:0 0 8px;color:#192C7B;font-size:19px;font-weight:800">اختبار الأحمال</h3>
          <p style="margin:0;color:#686B70;font-size:14px;line-height:1.75">عينات من كل دفعة تحت حمل يفوق الاستخدام الفعلي.</p>
        </div>
      </div>
      <div data-reveal style="background:#F4F5F7;border-radius:20px;overflow:hidden">
        <div style="height:170px"><div class="ph-slot">الفحص النهائي</div></div>
        <div style="padding:24px 24px 28px">
          <div style="color:#B9C6F2;font-size:22px;font-weight:900;margin-bottom:6px">٠٤</div>
          <h3 style="margin:0 0 8px;color:#192C7B;font-size:19px;font-weight:800">الفحص والتغليف</h3>
          <p style="margin:0;color:#686B70;font-size:14px;line-height:1.75">فحص بصري كامل وختم دفعة قبل مغادرة المصنع.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section style="padding:0 48px 90px;background:#fff">
  <div style="max-width:1280px;margin:0 auto">
    <div data-reveal style="position:relative;height:460px;border-radius:26px;overflow:hidden;background:#0D1744">
      <img src="/assets/cat-ladders.jpg" alt="فيديو اختبار التحمل" class="cover" loading="lazy">
      <div style="position:absolute;inset:0;background:rgba(13,23,68,.45);pointer-events:none"></div>
      <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;pointer-events:none">
        <div style="width:96px;height:96px;border-radius:50%;background:rgba(255,255,255,.94);display:flex;align-items:center;justify-content:center;box-shadow:0 16px 44px rgba(0,0,0,.45)">
          <div style="width:0;height:0;border-block:17px solid transparent;border-inline-start:28px solid #192C7B;margin-inline-end:-7px"></div>
        </div>
        <div style="color:#fff;font-size:18px;font-weight:800">شاهد اختبار التحمل الفعلي</div>
      </div>
    </div>
  </div>
</section>

<section style="padding:0 48px 90px;background:#fff">
  <div style="max-width:1280px;margin:0 auto">
    <div data-reveal style="margin-bottom:36px">
      <h2 style="margin:0;color:#192C7B;font-size:32px;font-weight:900">الشهادات والاعتمادات</h2>
      <p style="margin:10px 0 0;color:#686B70;font-size:15.5px">تُرفع الشهادات الرسمية هنا فور اعتمادها من العميل.</p>
    </div>
    <div class="grid-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:22px">
      <div data-reveal style="height:220px;border-radius:18px;overflow:hidden;border:1.5px dashed #C9CDD6"><div class="ph-slot">شهادة جودة ١</div></div>
      <div data-reveal style="height:220px;border-radius:18px;overflow:hidden;border:1.5px dashed #C9CDD6"><div class="ph-slot">شهادة جودة ٢</div></div>
      <div data-reveal style="height:220px;border-radius:18px;overflow:hidden;border:1.5px dashed #C9CDD6"><div class="ph-slot">شهادة سلامة</div></div>
    </div>
  </div>
</section>

<section style="padding:0 48px 100px;background:#fff">
  <div data-reveal class="cta-band" style="padding:56px 64px">
    <div>
      <h2 style="margin:0 0 10px;color:#fff;font-size:30px;font-weight:900">تحتاج التفاصيل الفنية؟</h2>
      <p style="margin:0;color:rgba(255,255,255,.75);font-size:16.5px">نرسل لك مواصفات الاختبار وتقارير الأحمال لأي منتج.</p>
    </div>
    <a href="/contact" class="btn-white">تواصل مع الفريق الفني</a>
  </div>
</section>
