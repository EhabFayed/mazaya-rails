<% content_for :title, "المشاريع — ألمنيوم مزايا" %>
<% content_for :description, "منتجات مزايا تعمل في أكبر مشاريع المملكة: روشن، الدرعية، ساكو، وأبراج الرياض." %>
<% content_for :nav_active, "projects" %>

<section style="background:#0D1744;padding:170px 48px 80px">
  <div style="max-width:1280px;margin:0 auto">
    <div data-reveal class="kicker">المشاريع</div>
    <h1 data-reveal style="margin:0 0 16px;color:#fff;font-size:clamp(40px,4.5vw,64px);font-weight:900">إثبات بالمشاريع، لا بالكلام</h1>
    <p data-reveal style="margin:0;color:rgba(255,255,255,.75);font-size:19px;line-height:1.8;max-width:620px">منتجاتنا تعمل يوميًا في أكبر مشاريع المملكة. لكل مشروع قصة: تحدٍّ، حل، ونتيجة.</p>
  </div>
</section>

<section style="padding:80px 48px 40px;background:#F4F5F7">
  <div data-reveal class="grid-2" style="max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1.2fr .8fr;background:#fff;border-radius:26px;overflow:hidden;box-shadow:0 4px 24px rgba(25,44,123,.08)">
    <div style="position:relative;min-height:460px">
      <img src="/assets/proj-roshn.jpg" alt="مشروع روشن" class="cover" loading="lazy">
      <div style="position:absolute;top:20px;inset-inline-start:20px;background:#192C7B;color:#fff;font-size:13px;font-weight:700;border-radius:999px;padding:8px 18px;pointer-events:none">مشروع مميز</div>
    </div>
    <div style="padding:56px;display:flex;flex-direction:column;gap:18px;justify-content:center">
      <div style="color:#686B70;font-size:13px;font-weight:700;letter-spacing:2px">مشروع سكني كبير</div>
      <h2 style="margin:0;color:#192C7B;font-size:36px;font-weight:900">روشن</h2>
      <div style="display:grid;gap:14px">
        <div><div style="color:#192C7B;font-weight:800;font-size:15.5px;margin-bottom:4px">التحدي</div><div style="color:#686B70;font-size:15px;line-height:1.75">توريد معدات عمل مرتفع لمواقع متعددة بجدول زمني ضاغط.</div></div>
        <div><div style="color:#192C7B;font-weight:800;font-size:15.5px;margin-bottom:4px">الحل</div><div style="color:#686B70;font-size:15px;line-height:1.75">خط توريد مباشر من المصنع مع مخزون مخصص للمشروع.</div></div>
        <div><div style="color:#192C7B;font-weight:800;font-size:15.5px;margin-bottom:4px">النتيجة</div><div style="color:#686B70;font-size:15px;line-height:1.75">صفر تأخير في التسليم وصفر حوادث متعلقة بالمعدات.</div></div>
      </div>
      <a href="/contact" style="color:#192C7B;font-weight:800;font-size:15.5px;margin-top:6px">اطلب استشارة لمشروعك ←</a>
    </div>
  </div>
</section>

<section style="padding:40px 48px 90px;background:#F4F5F7">
  <div class="grid-2" style="max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(2,1fr);gap:24px">
    
    <div data-reveal style="position:relative;border-radius:22px;overflow:hidden;height:380px;background:#0D1744">
      <img src="/assets/proj-diriyah.jpg" alt="الدرعية" class="cover" loading="lazy">
      <div style="position:absolute;inset:0;display:flex;flex-direction:column;justify-content:end;padding:28px;background:linear-gradient(0deg,rgba(13,23,68,.94) 0%,rgba(13,23,68,.25) 55%,transparent 100%);pointer-events:none;box-sizing:border-box">
        <div style="color:#B9C6F2;font-size:13px;font-weight:700;letter-spacing:1px;margin-bottom:6px">مشروع تراثي وطني</div>
        <div style="color:#fff;font-size:26px;font-weight:900;margin-bottom:8px">الدرعية</div>
        <div style="color:rgba(255,255,255,.75);font-size:14.5px;line-height:1.7">معدات عمل مرتفع لمواقع ترميم حساسة تتطلب خفة وزن ودقة.</div>
      </div>
    </div>
    <div data-reveal style="position:relative;border-radius:22px;overflow:hidden;height:380px;background:#0D1744">
      <img src="/assets/proj-saco.jpg" alt="ساكو" class="cover" loading="lazy">
      <div style="position:absolute;inset:0;display:flex;flex-direction:column;justify-content:end;padding:28px;background:linear-gradient(0deg,rgba(13,23,68,.94) 0%,rgba(13,23,68,.25) 55%,transparent 100%);pointer-events:none;box-sizing:border-box">
        <div style="color:#B9C6F2;font-size:13px;font-weight:700;letter-spacing:1px;margin-bottom:6px">شريك تجزئة رئيسي</div>
        <div style="color:#fff;font-size:26px;font-weight:900;margin-bottom:8px">ساكو</div>
        <div style="color:rgba(255,255,255,.75);font-size:14.5px;line-height:1.7">توريد تشكيلة السلالم الكاملة لفروع التجزئة في المملكة.</div>
      </div>
    </div>
    <div data-reveal style="position:relative;border-radius:22px;overflow:hidden;height:380px;background:#0D1744">
      <img src="/assets/proj-tower.jpg" alt="أبراج الرياض" class="cover" loading="lazy">
      <div style="position:absolute;inset:0;display:flex;flex-direction:column;justify-content:end;padding:28px;background:linear-gradient(0deg,rgba(13,23,68,.94) 0%,rgba(13,23,68,.25) 55%,transparent 100%);pointer-events:none;box-sizing:border-box">
        <div style="color:#B9C6F2;font-size:13px;font-weight:700;letter-spacing:1px;margin-bottom:6px">أبراج ومنشآت تجارية</div>
        <div style="color:#fff;font-size:26px;font-weight:900;margin-bottom:8px">أبراج الرياض</div>
        <div style="color:rgba(255,255,255,.75);font-size:14.5px;line-height:1.7">حلول مخصصة لأعمال الواجهات والصيانة الدورية.</div>
      </div>
    </div>
    <div data-reveal style="position:relative;border-radius:22px;overflow:hidden;height:380px;background:#0D1744">
      <img src="/assets/proj-infra.jpg" alt="مشاريع البنية التحتية" class="cover" loading="lazy">
      <div style="position:absolute;inset:0;display:flex;flex-direction:column;justify-content:end;padding:28px;background:linear-gradient(0deg,rgba(13,23,68,.94) 0%,rgba(13,23,68,.25) 55%,transparent 100%);pointer-events:none;box-sizing:border-box">
        <div style="color:#B9C6F2;font-size:13px;font-weight:700;letter-spacing:1px;margin-bottom:6px">بنية تحتية وطنية</div>
        <div style="color:#fff;font-size:26px;font-weight:900;margin-bottom:8px">مشاريع البنية التحتية</div>
        <div style="color:rgba(255,255,255,.75);font-size:14.5px;line-height:1.7">عربات ومنصات عمل لبيئات تشغيل قاسية على مدار الساعة.</div>
      </div>
    </div>
  </div>
</section>

<section style="padding:0 48px 100px;background:#F4F5F7">
  <div data-reveal class="cta-band" style="padding:56px 64px">
    <div>
      <h2 style="margin:0 0 10px;color:#fff;font-size:30px;font-weight:900">مشروعك القادم يستحق الأصل</h2>
      <p style="margin:0;color:rgba(255,255,255,.75);font-size:16.5px">أرسل تفاصيل مشروعك وسنعود إليك بخطة توريد خلال يوم عمل.</p>
    </div>
    <a href="/contact" class="btn-white">اطلب استشارة لمشروعك</a>
  </div>
</section>
