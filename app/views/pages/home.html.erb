    };
    // scaffolding tower (builds piece by piece)
    var scaffold = new THREE.Group(); root.add(scaffold);
    var pieces = []; var ord = 0;
    var P = function (m) { m.userData.tp = m.position.clone(); m.userData.ord = ord++; scaffold.add(m); pieces.push(m); return m; };
    var SW = 1.15, SD = 0.85, corners = [[-SW/2, -SD/2], [SW/2, -SD/2], [SW/2, SD/2], [-SW/2, SD/2]];
    corners.forEach(function (c) { var j = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.06, 0.2), navy); j.position.set(c[0], -1.31, c[1]); P(j); });
    corners.forEach(function (c) { var s = tube(2.8, 0.036); s.position.set(c[0], 0.12, c[1]); P(s); });
    var levels = [-1.02, -0.36, 0.32, 0.98];
    levels.forEach(function (y) {
      [-SD/2, SD/2].forEach(function (z) { P(spanTube(V3(-SW/2, y, z), V3(SW/2, y, z), 0.024)); });
      [-SW/2, SW/2].forEach(function (x) { P(spanTube(V3(x, y, -SD/2), V3(x, y, SD/2), 0.024)); });
      corners.forEach(function (c) { var cl = tube(0.07, 0.052, navy); cl.position.set(c[0], y, c[1]); P(cl); });
    });
    [-SD/2, SD/2].forEach(function (z, i) {
      P(spanTube(V3(i ? SW/2 : -SW/2, -1.02, z), V3(i ? -SW/2 : SW/2, 0.32, z), 0.018, aluB));
      P(spanTube(V3(i ? -SW/2 : SW/2, -0.36, z), V3(i ? SW/2 : -SW/2, 0.98, z), 0.018, aluB));
    });
    [-0.28, 0, 0.28].forEach(function (z) { var pl = new THREE.Mesh(new THREE.BoxGeometry(SW + 0.14, 0.045, 0.25), aluBox); pl.position.set(0, 1.02, z); P(pl); });
    [1.24, 1.5].forEach(function (y) { [-SD/2, SD/2].forEach(function (z) { P(spanTube(V3(-SW/2, y, z), V3(SW/2, y, z), 0.02)); }); });
    [-SW/2, SW/2].forEach(function (x) { P(spanTube(V3(x, 1.5, -SD/2), V3(x, 1.5, SD/2), 0.02)); });
    var NPC = pieces.length;
    // A-frame ladder (phase 2)
    var ladder = new THREE.Group(); root.add(ladder);
    var tilt = 0.24, LH = 2.4, W = 1.0, zc = Math.tan(tilt) * LH / 2, sinT = Math.sin(tilt);
    var zAt = function (y, lean) { return lean * (-zc + y * sinT); };
    [-W/2, W/2].forEach(function (x) { [1, -1].forEach(function (lean) {
      var m = new THREE.Mesh(new THREE.BoxGeometry(0.09, LH + 0.05, 0.065), aluBox);
      m.position.set(x, 0, lean * -zc); m.rotation.x = lean * tilt; ladder.add(m);
    }); });
    for (var i = 0; i < 5; i++) {
      var y = -LH/2 + 0.28 + i * 0.42;
      var step = new THREE.Mesh(new THREE.BoxGeometry(W + 0.04, 0.06, 0.22), aluBox);
      step.position.set(0, y, zAt(y, 1)); ladder.add(step);
      var grip = new THREE.Mesh(new THREE.BoxGeometry(W + 0.041, 0.012, 0.22), navy);
      grip.position.set(0, y + 0.035, zAt(y, 1)); ladder.add(grip);
    }
    var top = new THREE.Mesh(new THREE.BoxGeometry(W + 0.16, 0.1, 0.36), navy);
    top.position.set(0, LH/2 + 0.05, 0); ladder.add(top);
    [-W/2, W/2].forEach(function (x) { [1, -1].forEach(function (lean) {
      var foot = new THREE.Mesh(new THREE.BoxGeometry(0.13, 0.1, 0.17), rubber);
      foot.position.set(x, -LH/2 - 0.045, zAt(-LH/2, lean)); ladder.add(foot);
    }); });
    [-0.32, 0.34].forEach(function (y) { ladder.add(spanTube(V3(-W/2 + 0.02, y, zAt(y, -1)), V3(W/2 - 0.02, y, zAt(y, -1)), 0.022, aluB)); });
    var badge = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.16, 0.02), navy);
    badge.position.set(0, -0.02, zAt(-0.02, 1) - 0.115); ladder.add(badge);
    ladder.scale.setScalar(0.001); ladder.visible = false;
    // scroll-driven timeline
    var stage = document.getElementById('stage3d');
    var phaseA = document.getElementById('phaseA'), phaseB = document.getElementById('phaseB');
    var specsA = Array.prototype.slice.call(document.querySelectorAll('[data-spec-a]'));
    var specsB = Array.prototype.slice.call(document.querySelectorAll('[data-spec-b]'));
    var showSpecs = function (list, on) {
      list.forEach(function (el, i) {
        el.style.transitionDelay = on ? (i * 130 + 'ms') : '0ms';
        el.style.opacity = on ? '1' : '0';
        el.style.transform = on ? 'none' : 'translateX(30px)';
      });
    };
    var clamp01 = function (v) { return Math.min(Math.max(v, 0), 1); };
    var smooth = function (v) { return v * v * (3 - 2 * v); };
    var t = 0, phase = -1, aSpecs = false;
    var resize = function () {
      var w = host.clientWidth || 1, h = host.clientHeight || 1;
      renderer.setSize(w, h); camera.aspect = w / h; camera.updateProjectionMatrix();
    };
    resize();
    new ResizeObserver(resize).observe(host);
    var loop = function () {
      requestAnimationFrame(loop);
      var r = stage.getBoundingClientRect();
      var prog = clamp01(-r.top / (r.height - innerHeight));
      t += 0.004;
      var build = clamp01(prog / 0.5);
      var swap = smooth(clamp01((prog - 0.56) / 0.16));
      pieces.forEach(function (m) {
        var start = (m.userData.ord / NPC) * 0.82;
        var e = 1 - Math.pow(1 - clamp01((build - start) / 0.18), 3);
        m.position.y = m.userData.tp.y + (1 - e) * 2.4;
        m.scale.setScalar(Math.max(e, 0.001));
      });
      scaffold.visible = swap < 0.999;
      scaffold.position.y = -swap * 3;
      scaffold.rotation.y = swap * 1.2;
      var ls = swap * (1.18 - 0.18 * swap);
      ladder.visible = swap > 0.001;
      ladder.scale.setScalar(Math.max(ls, 0.001));
      ladder.position.y = 0.1 - (1 - swap) * 1.6;
      root.rotation.y = prog * Math.PI * 3 + t;
      root.rotation.x = 0.07 + Math.sin(prog * Math.PI) * 0.12;
      root.position.y = Math.sin(t * 2) * 0.03;
      renderer.render(scene, camera);
      var ph = prog > 0.6 ? 1 : 0;
      if (!aSpecs && prog > 0.04) { aSpecs = true; showSpecs(specsA, true); }
      if (ph !== phase) {
        phase = ph;
        phaseA.style.opacity = ph ? '0' : '1';
        phaseA.style.transform = ph ? 'translateY(-28px)' : 'none';
        phaseA.style.pointerEvents = ph ? 'none' : 'auto';
        phaseB.style.opacity = ph ? '1' : '0';
        phaseB.style.transform = ph ? 'none' : 'translateY(28px)';
        phaseB.style.pointerEvents = ph ? 'auto' : 'none';
        showSpecs(specsB, !!ph);
        if (ph) showSpecs(specsA, false); else if (aSpecs) showSpecs(specsA, true);
      }
    };
    loop();
  }
  setup3d();
})();
</script>
</body>
</html>
