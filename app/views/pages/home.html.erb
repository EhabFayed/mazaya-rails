    if (f.get('message')) lines.push('الرسالة: ' + f.get('message'));
    window.open(WA_HREF + '?text=' + encodeURIComponent(lines.join('\n')), '_blank', 'noopener');
  });

  // ---- trust marquee (two identical groups for seamless loop) ----
  var clients = [
    { name: 'ساكو SACO', logo: 'assets/logo-saco.png', bg: '#0D1744' },
    { name: 'روشن ROSHN', logo: 'assets/logo-roshn.svg', bg: '#FFFFFF' },
    { name: 'الدرعية DIRIYAH', logo: 'assets/logo-diriyah.png', bg: '#F7F1E6' },
    { name: 'ساكو SACO', logo: 'assets/logo-saco.png', bg: '#0D1744' },
    { name: 'روشن ROSHN', logo: 'assets/logo-roshn.svg', bg: '#FFFFFF' },
    { name: 'الدرعية DIRIYAH', logo: 'assets/logo-diriyah.png', bg: '#F7F1E6' }
  ];
  var row = document.getElementById('marqueeRow');
  for (var g = 0; g < 2; g++) {
    var group = document.createElement('div');
    group.style.cssText = 'display:flex;gap:90px;padding:0 45px;align-items:center';
    clients.forEach(function (c) {
      var item = document.createElement('div');
      item.style.cssText = 'display:flex;align-items:center;gap:16px;white-space:nowrap';
      var tile = document.createElement('div');
      tile.style.cssText = 'width:64px;height:64px;border-radius:14px;overflow:hidden;flex-shrink:0;background:' + c.bg + ';display:flex;align-items:center;justify-content:center;padding:9px;box-sizing:border-box';
      var img = document.createElement('img');
      img.src = c.logo; img.alt = c.name; img.loading = 'lazy';
      img.style.cssText = 'max-width:100%;max-height:100%;display:block';
      tile.appendChild(img);
      var label = document.createElement('div');
      label.style.cssText = 'color:#9AA0A8;font-size:28px;font-weight:900;letter-spacing:1px';
      label.textContent = c.name;
      item.appendChild(tile); item.appendChild(label);
      group.appendChild(item);
    });
    row.appendChild(group);
  }

  // ---- categories switcher ----
  var catItems = Array.prototype.slice.call(document.querySelectorAll('.cat-item'));
  var catBgs = Array.prototype.slice.call(document.querySelectorAll('.cat-bg'));
  function setActiveCat(i) {
    catItems.forEach(function (el, j) { el.classList.toggle('active', j === i); });
    catBgs.forEach(function (el, j) { el.classList.toggle('active', j === i); });
  }
  catItems.forEach(function (el, i) {
    el.addEventListener('mouseenter', function () { setActiveCat(i); });
    el.addEventListener('click', function () { setActiveCat(i); });
  });

  // ---- splash ----
  function setupSplash() {
    var splash = document.getElementById('splash');
    if (!splash) return;
    document.body.style.overflow = 'hidden';
    var rig = document.getElementById('splashRig'),
        carrier = document.getElementById('splashCarrier'),
        tag = document.getElementById('splashTag');
    var H = innerHeight;
    var METAL = 'linear-gradient(180deg,#F2F4F8 0%,#C6CBD4 42%,#9AA0AB 55%,#DFE3EA 100%)';
    var METALV = 'linear-gradient(90deg,#F2F4F8 0%,#C6CBD4 42%,#9AA0AB 55%,#DFE3EA 100%)';
    var bar = function (css, delay, from) {
      var b = document.createElement('div');
      b.style.cssText = 'position:absolute;border-radius:3px;box-shadow:0 4px 14px rgba(0,0,0,.4);opacity:0;transition:transform .7s cubic-bezier(.2,.9,.3,1) ' + delay + 'ms, opacity .4s ease ' + delay + 'ms;transform:' + from + ';' + css;
      rig.appendChild(b);
      return b;
    };
    var bars = [];
    var TW = 190, GAP = 300;
    [-1, 1].forEach(function (side) {
      var edge = side === -1 ? 'right:calc(50% + ' + (GAP / 2) + 'px)' : 'left:calc(50% + ' + (GAP / 2) + 'px)';
      var inner = edge;
      bars.push(bar(edge + ';top:-2%;height:104%;width:9px;background:' + METALV, 100, 'translateY(' + (side * 40) + 'vh)'));
      bars.push(bar((side === -1 ? 'right' : 'left') + ':calc(50% + ' + (GAP / 2 + TW) + 'px);top:-2%;height:104%;width:9px;background:' + METALV, 220, 'translateY(' + (-side * 40) + 'vh)'));
      for (var i = 0; i < 6; i++) {
        bars.push(bar(inner + ';top:' + (4 + i * 18) + '%;width:' + (TW + 9) + 'px;height:7px;background:' + METAL, 350 + i * 110, 'translateX(' + (side * 60) + 'vw)'));
      }
      for (var k = 0; k < 5; k++) {
        var up = k % 2 === 0 ? 1 : -1;
        bars.push(bar(inner + ';top:' + (4 + k * 18 + 9) + '%;width:' + Math.hypot(TW, H * 0.18) + 'px;height:5px;background:' + METAL + ';transform-origin:' + (side === -1 ? '100%' : '0') + ' 50%;opacity:.9', 500 + k * 110, 'translateX(' + (side * 60) + 'vw) rotate(0deg)'));
        var el = bars[bars.length - 1];
        el.dataset.rot = (side === -1 ? 1 : -1) * up * (Math.atan2(H * 0.18, TW) * 180 / Math.PI);
      }
    });
    bar('left:calc(50% - ' + (GAP / 2 + TW) + 'px);right:calc(50% - ' + (GAP / 2 + TW) + 'px);top:2.5%;height:10px;background:' + METAL + ';border-radius:4px', 900, 'translateY(-60px)');
    var cables = [-70, 70].map(function (x) {
      var c = document.createElement('div');
      c.style.cssText = 'position:absolute;left:calc(50% + ' + x + 'px);top:3.2%;width:3px;height:0;background:linear-gradient(180deg,#AEB4BE,#7E848E);opacity:0;transition:opacity .3s';
      rig.appendChild(c);
      return c;
    });
    requestAnimationFrame(function () { requestAnimationFrame(function () {
      bars.forEach(function (b) {
        b.style.transform = b.dataset.rot ? 'rotate(' + b.dataset.rot + 'deg)' : 'none';
        b.style.opacity = '1';
      });
    }); });
    var topY = H * 0.032, endY = H * 0.46, DESC = 2400;
    setTimeout(function () {
      cables.forEach(function (c) { c.style.opacity = '1'; });
      carrier.style.transform = 'translate(-50%, ' + topY + 'px)';
      carrier.style.transition = 'transform .01s';
      requestAnimationFrame(function () {
        carrier.style.transition = 'transform ' + DESC + 'ms cubic-bezier(.35,0,.3,1)';
        carrier.style.transform = 'translate(-50%, ' + endY + 'px)';
        cables.forEach(function (c) {
          c.style.transition = 'height ' + DESC + 'ms cubic-bezier(.35,0,.3,1), opacity .3s';
          c.style.height = (endY - topY + 20) + 'px';
        });
      });
      setTimeout(function () { tag.style.opacity = '1'; }, DESC * 0.55);
    }, 1500);
    setTimeout(function () {
      splash.style.transition = 'transform 1.15s cubic-bezier(.65,0,.35,1)';
      splash.style.transform = 'translateY(102%)';
      setTimeout(function () { splash.remove(); document.body.style.overflow = ''; }, 1200);
    }, 1500 + DESC + 500);
  }
  setupSplash();

  // ---- scroll reveals ----
  var reveals = document.querySelectorAll('[data-reveal]');
  reveals.forEach(function (el) {
    el.style.opacity = '0';
    el.style.transform = 'translateY(28px)';
    el.style.transition = 'opacity .8s ease, transform .8s ease';
  });
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (en) {
      if (en.isIntersecting) {
        en.target.style.opacity = '1';
        en.target.style.transform = 'none';
        io.unobserve(en.target);
      }
    });
  }, { threshold: 0.12 });
  reveals.forEach(function (el) { io.observe(el); });

  // ---- counters ----
  var cio = new IntersectionObserver(function (entries) {
    entries.forEach(function (en) {
      if (!en.isIntersecting) return;
      var el = en.target, target = +el.getAttribute('data-count'), t0 = performance.now();
      var tick = function (now) {
        var p = Math.min((now - t0) / 1600, 1), e = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(target * e).toLocaleString('ar-EG');
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      cio.unobserve(el);
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('[data-count]').forEach(function (el) { cio.observe(el); });

  // ---- projects rail ----
  (function () {
    var sec = document.getElementById('projects'), track = document.getElementById('projTrack');
    if (!sec || !track) return;
    var loop = function () {
      requestAnimationFrame(loop);
      var r = sec.getBoundingClientRect();
      var prog = Math.min(Math.max(-r.top / (r.height - innerHeight), 0), 1);
      var max = Math.max(track.scrollWidth - track.parentElement.clientWidth, 0);
      track.style.transform = 'translateX(' + (prog * max) + 'px)';
    };
    loop();
  })();

  // ---- 3D scaffold + ladder stage ----
  async function setup3d() {
    var host = document.getElementById('ladder3d');
    if (!host || !window.WebGLRenderingContext) return;
    var THREE;
    try {
      THREE = await import('https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js');
    } catch (err) { return; }
    var renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.domElement.style.cssText = 'position:absolute;inset:0;width:100%;height:100%';
    host.appendChild(renderer.domElement);
    var scene = new THREE.Scene();
    var camera = new THREE.PerspectiveCamera(40, 1, 0.1, 50);
    camera.position.set(0, 0.35, 5.6);
    var pmrem = new THREE.PMREMGenerator(renderer);
    var envScene = new THREE.Scene();
    envScene.background = new THREE.Color(0x5a6a9e);
    var addPanel = function (color, w, h, x, y, z) {
      var m = new THREE.Mesh(new THREE.PlaneGeometry(w, h), new THREE.MeshBasicMaterial({ color: color }));
      m.position.set(x, y, z); m.lookAt(0, 0, 0); envScene.add(m);
    };
    addPanel(0xffffff, 9, 9, 0, 10, 2);
    addPanel(0xb9c6f2, 6, 12, -10, 3, 5);
    addPanel(0x8fa3e8, 6, 12, 10, 2, -4);
    addPanel(0x27356f, 24, 8, 0, -9, 0);
    addPanel(0xcdd6ee, 10, 8, 2, 3, 11);
    scene.environment = pmrem.fromScene(envScene).texture;
    scene.add(new THREE.HemisphereLight(0xdde4ff, 0x1a2350, 0.7));
    var key = new THREE.DirectionalLight(0xffffff, 1.6); key.position.set(3, 5, 4); scene.add(key);
    var rim = new THREE.DirectionalLight(0xb9c6f2, 1.1); rim.position.set(-4, 2, -3); scene.add(rim);
    var alu = new THREE.MeshStandardMaterial({ color: 0xd9dde3, metalness: 0.9, roughness: 0.25 });
    var aluB = new THREE.MeshStandardMaterial({ color: 0xc3c8d0, metalness: 0.8, roughness: 0.42 });
    var aluBox = new THREE.MeshStandardMaterial({ color: 0xd6dae1, metalness: 0.72, roughness: 0.36 });
    var navy = new THREE.MeshStandardMaterial({ color: 0x192c7b, metalness: 0.35, roughness: 0.42 });
    var rubber = new THREE.MeshStandardMaterial({ color: 0x23262b, metalness: 0, roughness: 0.9 });
    var root = new THREE.Group(); scene.add(root);
    var V3 = function (x, y, z) { return new THREE.Vector3(x, y, z); };
    var tube = function (len, r, mat) { return new THREE.Mesh(new THREE.CylinderGeometry(r, r, len, 14), mat || alu); };
    var spanTube = function (a, b, r, mat) {
      var dir = b.clone().sub(a), m = tube(dir.length(), r, mat);
      m.quaternion.setFromUnitVectors(V3(0, 1, 0), dir.clone().normalize());
