</header>
<nav class="mobile-nav">
  <a href="#hero" class="current">الرئيسية</a>
  <a href="/about">من نحن</a>
  <a href="/products">المنتجات</a>
  <a href="/projects">المشاريع</a>
  <a href="/quality">الجودة والسلامة</a>
  <a href="/partners">شراكة معنا</a>
