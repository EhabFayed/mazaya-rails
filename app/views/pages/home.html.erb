    <div data-reveal style="border-inline-start:1px solid rgba(255,255,255,.14);padding-inline-start:24px">
      <div style="color:#fff;font-size:36px;font-weight:900;line-height:1"><span data-count="88">0</span><span style="color:#B9C6F2">%</span></div>
      <div style="color:rgba(255,255,255,.7);font-size:15px;font-weight:500;margin-top:8px">حصة السوق المحلي</div>
    </div>
    <div data-reveal style="border-inline-start:1px solid rgba(255,255,255,.14);padding-inline-start:24px">
      <div style="color:#fff;font-size:36px;font-weight:900;line-height:1"><span data-count="350">0</span><span style="color:#B9C6F2">+</span></div>
      <div style="color:rgba(255,255,255,.7);font-size:15px;font-weight:500;margin-top:8px">موزّع معتمد</div>
    </div>
    <div data-reveal style="border-inline-start:1px solid rgba(255,255,255,.14);padding-inline-start:24px">
      <div style="color:#fff;font-size:36px;font-weight:900;line-height:1"><span data-count="7">0</span><span style="color:#B9C6F2"></span></div>
      <div style="color:rgba(255,255,255,.7);font-size:15px;font-weight:500;margin-top:8px">أسواق تصدير</div>
    </div>
  </div>
</section>

<!-- categories -->
<section id="categories" style="position:relative;min-height:92vh;background:#0D1744;overflow:hidden;display:flex;align-items:center">
  <div class="cat-bg active"><img src="/assets/cat-ladders.jpg" alt="صورة السلالم" loading="lazy"></div>
  <div class="cat-bg"><img src="/assets/cat-carts.jpg" alt="صورة العربات" loading="lazy"></div>
  <div class="cat-bg"><img src="/assets/cat-custom.jpg" alt="صورة الحلول المخصصة" loading="lazy"></div>
  <div style="position:absolute;inset:0;background:linear-gradient(270deg,rgba(13,23,68,.92) 0%,rgba(13,23,68,.68) 50%,rgba(13,23,68,.3) 100%);pointer-events:none"></div>
