<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ألمنيوم مزايا — الأصل له اسم واحد</title>
<meta name="description" content="مصنع سعودي لمنتجات الألمنيوم منذ ١٩٨٩. سلالم، عربات صناعية، وحلول مخصصة للمشاريع الكبرى.">
<link rel="icon" type="image/png" href="/assets/logo.png">
<meta property="og:type" content="website">
<meta property="og:title" content="ألمنيوم مزايا — الأصل له اسم واحد">
<meta property="og:description" content="مصنع سعودي لمنتجات الألمنيوم منذ ١٩٨٩. سلالم، عربات صناعية، وحلول مخصصة للمشاريع الكبرى.">
<meta property="og:image" content="https://mazaya-swart.vercel.app/assets/hero.jpg">
<meta property="og:locale" content="ar_SA">
<style>
@font-face{font-family:'GE SS Two';src:url('/fonts/GESSTwo-Light.otf') format('opentype');font-weight:400;font-display:swap}
@font-face{font-family:'GE SS Two';src:url('/fonts/GESSTwo-Medium.otf') format('opentype');font-weight:500;font-display:swap}
@font-face{font-family:'GE SS Two';src:url('/fonts/GESSTwo-Medium.otf') format('opentype');font-weight:600;font-display:swap}
@font-face{font-family:'GE SS Two';src:url('/fonts/GESSTwo-Bold.otf') format('opentype');font-weight:700;font-display:swap}
@font-face{font-family:'GE SS Two';src:url('/fonts/GESSTwo-Bold.otf') format('opentype');font-weight:900;font-display:swap}
html{scroll-behavior:smooth}
body{margin:0;background:#FFFFFF;font-family:'GE SS Two','Segoe UI',Tahoma,sans-serif;color:#1A1C20}
a{color:#192C7B;text-decoration:none}
a:hover{color:#2A44B8}
::selection{background:#192C7B;color:#fff}
@keyframes heroZoom{from{transform:scale(1.08)}to{transform:scale(1)}}
@keyframes floatY{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(50%)}}
@keyframes pulseDot{0%,100%{box-shadow:0 0 0 0 rgba(37,211,102,.5)}50%{box-shadow:0 0 0 12px rgba(37,211,102,0)}}
@keyframes scrollCue{0%{opacity:0;transform:translateY(-6px)}30%{opacity:1}100%{opacity:0;transform:translateY(10px)}}
@keyframes splashLogoIn{from{opacity:0;transform:translateY(14px) scale(.96)}to{opacity:1;transform:none}}

.page{overflow-x:clip}

/* header */
.site-header{position:fixed;inset-inline:0;top:0;z-index:60;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:10px 48px;background:rgba(255,255,255,.94);backdrop-filter:blur(14px);border-bottom:1px solid #E6E8EC;box-shadow:0 2px 18px rgba(25,44,123,.06)}
.logo-chip{display:flex;align-items:center}
.logo-chip img{height:58px;display:block}
.main-nav{display:flex;align-items:center;gap:28px;font-size:15px;font-weight:500}
.main-nav a{color:rgba(25,44,123,.72)}
.main-nav a:hover{color:#192C7B}
.main-nav a.current{color:#192C7B;font-weight:800}
.wa-pill{display:flex;align-items:center;gap:8px;color:#192C7B;font-size:14px;font-weight:600;background:#F0F2F8;border:1px solid #D9DEEA;border-radius:999px;padding:9px 16px}
.wa-pill:hover{background:#E4E8F4;color:#192C7B}
.btn-quote{background:#fff;color:#192C7B;border:1.5px solid #192C7B;font-weight:700;font-size:14px;border-radius:999px;padding:9px 22px}
.btn-quote:hover{background:#192C7B;color:#fff}
.wa-dot{width:8px;height:8px;border-radius:50%;background:#25D366;animation:pulseDot 2s infinite}

/* hero */
.hero-cta{background:#fff;color:#192C7B;font-weight:700;font-size:17px;border-radius:12px;padding:16px 34px;box-shadow:0 8px 30px rgba(0,0,0,.35);transition:transform .3s;display:inline-block}
.hero-cta:hover{transform:translateY(-2px);color:#192C7B}
.hero-ghost{display:flex;align-items:center;gap:10px;color:#fff;font-weight:600;font-size:17px;border:1.5px solid rgba(255,255,255,.5);border-radius:12px;padding:16px 30px;transition:background .3s}
.hero-ghost:hover{background:rgba(255,255,255,.12);color:#fff}

/* categories */
.cat-bg{position:absolute;inset:0;opacity:0;transform:scale(1);transition:opacity .7s ease,transform 6s ease}
.cat-bg.active{opacity:1;transform:scale(1.06)}
.cat-bg img{width:100%;height:100%;object-fit:cover;display:block}
.cat-item{cursor:pointer;border-top:1px solid rgba(255,255,255,.18);padding:30px 0}
.cat-num{font-size:17px;font-weight:700;min-width:34px;color:rgba(255,255,255,.4);transition:color .4s}
.cat-title{margin:0;font-size:32px;font-weight:900;color:rgba(255,255,255,.45);transition:color .4s,font-size .4s;line-height:1.2}
.cat-arrow{margin-inline-start:auto;color:#B9C6F2;font-size:24px;opacity:0;transform:translateX(14px);transition:opacity .4s,transform .4s}
.cat-desc{max-height:0;overflow:hidden;opacity:0;transition:max-height .55s ease,opacity .5s ease}
.cat-item.active .cat-num{color:#B9C6F2}
.cat-item.active .cat-title{color:#fff;font-size:42px}
.cat-item.active .cat-arrow{opacity:1;transform:translateX(0)}
.cat-item.active .cat-desc{max-height:160px;opacity:1}
.cat-more{display:inline-flex;align-items:center;gap:8px;margin:10px 58px 0 0;color:#B9C6F2;font-weight:700;font-size:15px}
.cat-more:hover{color:#fff}

/* 3d specs */
.spec-card{display:flex;align-items:center;gap:14px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:14px;padding:14px 18px;opacity:0;transform:translateX(30px);transition:opacity .6s,transform .6s}
.spec-badge{width:44px;height:44px;border-radius:12px;background:rgba(185,198,242,.18);display:flex;align-items:center;justify-content:center;color:#B9C6F2;font-size:17px;font-weight:900;flex-shrink:0}

/* pillars */
.pillar{background:#F4F5F7;border-radius:20px;padding:38px 32px;transition:transform .35s}
.pillar:hover{transform:translateY(-6px)}
.btn-outline{display:inline-flex;align-items:center;gap:10px;border:2px solid #192C7B;border-radius:12px;padding:14px 30px;font-weight:700;font-size:16px;transition:background .3s,color .3s}
.btn-outline:hover{background:#192C7B;color:#fff}

/* partners */
.btn-partner{display:inline-block;background:#fff;color:#192C7B;font-weight:700;font-size:17px;border-radius:12px;padding:16px 36px;transition:transform .3s}
.btn-partner:hover{transform:translateY(-2px);color:#192C7B}

/* contact */
.field{font-family:inherit;font-size:16px;padding:15px 18px;border:1.5px solid #E0E3E9;border-radius:12px;outline:none;background:#FAFBFC;box-sizing:border-box;width:100%}
.field:focus{border-color:#192C7B}
select.field{padding:15px 14px;color:#686B70}
.form-btn{font-family:inherit;background:#192C7B;color:#fff;font-weight:700;font-size:17px;border:none;border-radius:12px;padding:16px;cursor:pointer;transition:background .3s}
.form-btn:hover{background:#12205C}
.wa-green{display:inline-flex;align-items:center;gap:12px;background:#25D366;color:#fff;font-weight:700;font-size:16px;border-radius:12px;padding:15px 28px;transition:transform .3s}
.wa-green:hover{transform:translateY(-2px);color:#fff}

/* footer */
.footer-link{color:rgba(255,255,255,.65)}
.footer-link:hover{color:#fff}
.social{width:42px;height:42px;border-radius:12px;background:rgba(255,255,255,.08);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:13px;transition:background .3s}
.social:hover{background:rgba(255,255,255,.2);color:#fff}

/* floating whatsapp */
.wa-fab{position:fixed;bottom:26px;left:26px;z-index:70;width:62px;height:62px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 26px rgba(37,211,102,.45);animation:floatY 3.5s ease-in-out infinite;color:#fff;font-size:28px}
.wa-fab:hover{transform:scale(1.08);color:#fff}

@media (max-height:720px){
  #phaseA h2,#phaseB h2{font-size:30px !important;margin-bottom:10px !important}
  #phaseA p,#phaseB p{font-size:14.5px !important;margin-bottom:14px !important;line-height:1.6 !important}
  #phaseA>div:first-child,#phaseB>div:first-child{margin-bottom:8px !important}
  .spec-card{padding:8px 14px !important}
  .spec-badge{width:36px !important;height:36px !important;font-size:14px !important}
}

/* mobile */
.menu-btn{display:none;background:#F0F2F8;border:1px solid #D9DEEA;border-radius:10px;color:#192C7B;font-size:20px;padding:7px 13px;cursor:pointer;font-family:inherit}
.mobile-nav{display:none;position:fixed;top:66px;inset-inline:0;z-index:59;background:rgba(255,255,255,.98);backdrop-filter:blur(14px);border-bottom:1px solid #E6E8EC;box-shadow:0 14px 30px rgba(25,44,123,.1);padding:10px 20px 18px;flex-direction:column;gap:2px}
.mobile-nav a{color:rgba(25,44,123,.8);font-size:16px;font-weight:600;padding:12px 6px;border-bottom:1px solid #EEF0F4}
.mobile-nav a.current{color:#192C7B;font-weight:800}
.mobile-nav.open{display:flex}
@media (max-width:960px){
  .site-header{padding:10px 18px;gap:12px}
  .logo-chip img{height:44px}
  .main-nav{display:none}
  .menu-btn{display:block}
  .wa-pill span[dir=ltr]{display:none}
  .hero-grid{grid-template-columns:1fr !important;padding:130px 20px 90px !important}
  .hero-grid h1{font-size:44px !important}
  .stats-grid{grid-template-columns:repeat(2,1fr) !important;text-align:center}
  .stats-grid>div{border-inline-start:none !important;padding-inline-start:0 !important}
  section{padding-left:20px;padding-right:20px}
  .cats-wrap{padding:90px 20px !important}
  .cat-item.active .cat-title{font-size:32px}
  h2{font-size:34px !important}
  .stage-grid{grid-template-columns:1fr !important}
  .stage-copy{padding:80px 20px 0 !important}
  #ladder3d{height:52vh !important}
  .pillars-grid{grid-template-columns:1fr !important}
  .partners-grid{grid-template-columns:1fr !important;gap:36px !important}
  .contact-grid{grid-template-columns:1fr !important;gap:36px !important}
  .footer-grid{grid-template-columns:1fr 1fr !important;gap:32px !important}
  .proj-card{width:82vw !important}
}
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important}
  html{scroll-behavior:auto}
}
</style>
</head>
<body>
<div class="page">

<!-- splash -->
<div id="splash" style="position:fixed;inset:0;z-index:200;background:radial-gradient(ellipse 70% 60% at 50% 45%,#1B2F86 0%,#0D1744 70%);overflow:hidden;will-change:transform">
  <div id="splashRig" style="position:absolute;inset:0;display:flex;justify-content:center;pointer-events:none"></div>
  <div id="splashCarrier" style="position:absolute;left:50%;top:0;transform:translate(-50%,-140%);will-change:transform;display:flex;flex-direction:column;align-items:center;gap:18px">
    <div id="splashLogo" style="background:#fff;border-radius:18px;padding:16px 30px;box-shadow:0 24px 70px rgba(0,0,0,.55)"><img src="/assets/logo.png" alt="ألمنيوم مزايا" style="height:74px;display:block"></div>
    <div id="splashTag" style="color:rgba(255,255,255,.75);font-size:16px;font-weight:600;letter-spacing:1px;opacity:0;transition:opacity .6s">الأصل له اسم واحد</div>
  </div>
</div>

<!-- header -->
<header class="site-header">
