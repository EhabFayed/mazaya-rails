</nav>

<!-- hero -->
<section id="hero" style="position:relative;min-height:100vh;display:flex;align-items:center;overflow:hidden;background:#0D1744">
  <img src="/assets/hero.jpg" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;animation:heroZoom 2.4s ease-out both">
  <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(13,23,68,.94) 0%,rgba(25,44,123,.78) 45%,rgba(13,23,68,.35) 100%)"></div>
  <div style="position:absolute;inset:0;background:linear-gradient(0deg,rgba(13,23,68,.9) 0%,transparent 35%)"></div>
  <div class="hero-grid" style="position:relative;z-index:2;padding:140px 48px 100px;max-width:1280px;margin:0 auto;width:100%;display:grid;grid-template-columns:1.2fr .8fr;gap:40px;align-items:center;box-sizing:border-box">
    <div>
      <div data-reveal style="display:inline-flex;align-items:center;gap:10px;color:#C9CDD4;font-size:14px;font-weight:600;letter-spacing:.5px;border:1px solid rgba(255,255,255,.25);border-radius:999px;padding:8px 18px;margin-bottom:28px">
        صناعة سعودية · منذ ١٩٨٩
      </div>
      <h1 data-reveal style="margin:0 0 22px;color:#fff;font-size:clamp(44px,5.5vw,76px);font-weight:900;line-height:1.15;text-wrap:pretty">الأصل له اسم واحد<br><span style="color:#B9C6F2">مزايا</span></h1>
      <p data-reveal style="margin:0 0 38px;color:rgba(255,255,255,.82);font-size:20px;font-weight:400;line-height:1.8;max-width:560px">سلالم وعربات ألمنيوم تُصنع في مصنعنا وتُختبر قبل أن تصل إليك. جودة يعرفها المقاول من أول استخدام.</p>
      <div data-reveal style="display:flex;gap:16px;flex-wrap:wrap">
        <a href="#contact" class="hero-cta">اطلب عرض سعر</a>
        <a data-wa class="hero-ghost" href="#"><svg width="18" height="18" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true" style="flex-shrink:0"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>واتساب مباشر</a>
      </div>
    </div>
    <div style="display:flex;justify-content:center"></div>
  </div>
  <div style="position:absolute;bottom:26px;inset-inline:0;display:flex;justify-content:center;z-index:2">
    <div style="width:26px;height:44px;border:2px solid rgba(255,255,255,.5);border-radius:14px;display:flex;justify-content:center;padding-top:8px"><div style="width:4px;height:9px;border-radius:3px;background:#fff;animation:scrollCue 1.8s infinite"></div></div>
  </div>
</section>

<!-- stats -->
<section style="background:#192C7B;padding:56px 48px">
  <div class="stats-grid" style="max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:32px;text-align:center">
    <div data-reveal style="border-inline-start:1px solid rgba(255,255,255,.14);padding-inline-start:24px">
      <div style="color:#fff;font-size:36px;font-weight:900;line-height:1"><span data-count="35">0</span><span style="color:#B9C6F2">+</span></div>
