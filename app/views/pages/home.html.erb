<% content_for :title, t("home.title") %>
<% content_for :description, t("home.description") %>
<% content_for :nav_active, "home" %>

<%# splash (once per session — handled in site.js) %>
<div id="splash">
  <div id="splashRig" style="position:absolute;inset:0;display:flex;justify-content:center;pointer-events:none"></div>
  <div id="splashCarrier" style="position:absolute;left:50%;top:0;transform:translate(-50%,-140%);will-change:transform;display:flex;flex-direction:column;align-items:center;gap:18px">
    <div style="background:#fff;border-radius:18px;padding:16px 30px;box-shadow:0 24px 70px rgba(0,0,0,.55)"><img src="/assets/logo.png" alt="<%= t("brand") %>" style="height:74px;display:block"></div>
    <div id="splashTag" style="color:rgba(255,255,255,.75);font-size:16px;font-weight:600;letter-spacing:1px;opacity:0;transition:opacity .6s"><%= t("tagline") %></div>
  </div>
</div>

<%# 01 — Hero %>
<section id="hero" class="hero">
  <img src="/assets/hero.jpg" alt="" class="hero-bg">
  <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(13,23,68,.94) 0%,rgba(25,44,123,.78) 45%,rgba(13,23,68,.35) 100%)"></div>
  <div style="position:absolute;inset:0;background:linear-gradient(0deg,rgba(13,23,68,.9) 0%,transparent 35%)"></div>
  <div class="hero-grid">
    <div>
      <div data-reveal class="hero-badge"><%= t("home.hero.badge") %></div>
      <% if rtl? %><h1 data-reveal>الأصل له اسم واحد:<br><span>مزايا</span></h1><% else %><h1 data-reveal>The Original.<br><span>The Trusted Name.</span></h1><% end %>
      <p data-reveal><%= t("home.hero.desc") %></p>
      <div data-reveal style="display:flex;gap:16px;flex-wrap:wrap">
        <a href="<%= rfq_path %>" class="hero-cta"><%= t("home.hero.primary") %></a>
        <a href="<%= products_path %>" class="hero-ghost"><%= t("home.hero.secondary") %> ←</a>
      </div>
    </div>
    <div></div>
  </div>
  <div class="scroll-cue"><div><div></div></div></div>
</section>

<%# 02 — Path selection (B2B / B2C) — visual, B2B weighted %>
<section id="paths" class="section-pad bg-soft">
  <div class="wrap">
    <%= render "shared/section_head", label: t("home.paths.label"), h2: t("home.paths.h2"), center: true %>
    <div class="doors">
      <a href="<%= b2b_path %>" data-reveal class="door b2b card-hover-lg">
        <img src="/assets/proj-tower.jpg" alt="">
        <div class="door-shade"></div>
        <div class="door-body">
          <div class="door-label"><%= t("home.paths.b2b_label") %></div>
          <h3><%= t("home.paths.b2b_title") %></h3>
          <p><%= t("home.paths.b2b_desc") %></p>
          <span class="btn-white"><%= t("home.paths.b2b_cta") %> ←</span>
        </div>
      </a>
      <a href="<%= products_path %>" data-reveal class="door b2c card-hover-lg">
        <img src="/assets/cat-ladders.jpg" alt="">
        <div class="door-shade"></div>
        <div class="door-body">
          <div class="door-label"><%= t("home.paths.b2c_label") %></div>
          <h3><%= t("home.paths.b2c_title") %></h3>
          <p><%= t("home.paths.b2c_desc") %></p>
          <span class="btn-ghost"><%= t("home.paths.b2c_cta") %> ←</span>
        </div>
      </a>
    </div>
  </div>
</section>

<%# 03 — Numbers %>
<section class="bg-navy" style="padding:64px 48px">
  <div class="wrap">
    <div data-reveal class="kicker" style="text-align:center;margin-bottom:36px"><%= t("home.numbers.h2") %></div>
    <div class="stat-grid">
      <% SiteData::STATS.each do |s| %>
      <div data-reveal class="stat">
        <div class="stat-num"><span data-count="<%= s[:value] %>">0</span><small><%= s[:suffix] %></small><% if s[:label].present? %> <small><%= s[:label] %></small><% end %></div>
        <div class="stat-sub"><%= s[:sub] %></div>
      </div>
      <% end %>
    </div>
  </div>
</section>

<%# 04 — Why Mazaya %>
<section id="why" class="section-pad bg-white">
  <div class="wrap">
    <%= render "shared/section_head", label: t("home.why.label"), h2: t("home.why.h2"), desc: t("home.why.intro"), center: true %>
    <div class="grid-4">
      <% t("home.why.cards").each_with_index do |(title, desc), i| %>
      <div data-reveal class="pillar">
        <div class="num-badge"><%= num(i + 1) %></div>
        <h3 style="margin:0 0 12px;color:#192C7B;font-size:21px;font-weight:800"><%= title %></h3>
        <p style="margin:0;color:#686B70;font-size:15px;line-height:1.8"><%= desc %></p>
      </div>
      <% end %>
    </div>
    <div data-reveal style="text-align:center;margin-top:44px"><a href="<%= about_path %>" class="btn-outline"><%= t("home.why.cta") %> ←</a></div>
  </div>
</section>

<%# 05 — Original vs counterfeit teaser %>
<section id="original" class="section-pad bg-dark" style="position:relative;overflow:hidden">
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse 50% 60% at 15% 50%,rgba(185,198,242,.14),transparent 70%)"></div>
  <div class="wrap grid-2" style="position:relative;align-items:center;gap:60px">
    <div data-reveal>
      <div class="kicker"><%= t("home.original.label") %></div>
      <h2 style="margin:0 0 18px;color:#fff;font-size:42px;font-weight:900;line-height:1.25"><%= t("home.original.h2") %></h2>
      <p style="margin:0 0 12px;color:rgba(255,255,255,.78);font-size:17.5px;line-height:1.8"><%= t("home.original.desc") %></p>
      <p style="margin:0 0 32px;color:rgba(255,255,255,.65);font-size:16px;line-height:1.8"><%= t("home.original.desc2") %></p>
      <a href="<%= original_path %>" class="btn-white"><%= t("home.original.cta") %></a>
    </div>
    <div data-reveal class="grid-2m" style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
      <% SiteData::AUTHENTICITY_CHECKS.each_with_index do |(title, _), i| %>
      <div class="feature-card dark" style="padding:24px 22px">
        <div style="color:#B9C6F2;font-size:22px;font-weight:900;margin-bottom:8px"><%= num(i + 1) %></div>
        <h3 style="font-size:17px"><%= title %></h3>
      </div>
      <% end %>
    </div>
  </div>
</section>

<%# 06 — Selected projects (image is the hero, not the text) %>
<section id="projects" class="section-pad bg-soft">
  <div class="wrap">
    <%= render "shared/section_head", label: t("home.projects.label"), h2: t("home.projects.h2"), desc: t("home.projects.desc"), link: [ t("home.projects.cta"), projects_path ] %>
    <div class="grid-3">
      <% @featured_projects.each do |p| %><%= render "shared/project_card", project: p, tall: true %><% end %>
    </div>
  </div>
</section>

<%# 07 — Distributors & partners banner %>
<section id="partners" class="section-pad bg-navy" style="position:relative;overflow:hidden">
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse 50% 60% at 85% 50%,rgba(185,198,242,.16),transparent 70%)"></div>
  <div class="wrap grid-2" style="position:relative;align-items:center;gap:60px">
    <div data-reveal style="height:380px;border-radius:24px;overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,.3)"><img src="/assets/cat-carts.jpg" alt="" class="cover" loading="lazy"></div>
    <div data-reveal>
      <div class="kicker"><%= t("home.partners.label") %></div>
      <h2 style="margin:0 0 20px;color:#fff;font-size:42px;font-weight:900;line-height:1.25"><%= t("home.partners.h2") %></h2>
      <p style="margin:0 0 36px;color:rgba(255,255,255,.75);font-size:17.5px;line-height:1.8"><%= t("home.partners.desc") %></p>
      <a href="<%= partners_path %>" class="btn-white"><%= t("home.partners.cta") %></a>
    </div>
  </div>
</section>

<%# 08 — Latest news (3 posts) %>
<section id="news" class="section-pad bg-white">
  <div class="wrap">
    <%= render "shared/section_head", label: t("home.news.label"), h2: t("home.news.h2"), desc: t("home.news.desc"), link: [ t("nav.news"), news_path ] %>
    <div class="grid-3">
      <% @latest_news.each do |post| %><%= render "shared/post_card", post: post %><% end %>
    </div>
    <div data-reveal style="display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-top:40px" id="social">
      <span style="align-self:center;color:#686B70;font-weight:700;font-size:15px"><%= t("home.news.cta") %></span>
      <% SiteData::SOCIAL.each do |s| %><a href="<%= s[:url] %>" class="social" style="background:#192C7B" title="<%= s[:label] %>" target="_blank" rel="noopener"><%= s[:abbr] %></a><% end %>
    </div>
  </div>
</section>

<%# trust strip %>
<section style="background:#fff;padding:0 0 64px;overflow:hidden">
  <div data-reveal class="kicker-gray" style="text-align:center;margin-bottom:36px"><%= t("footer.trust") %></div>
  <div id="marqueeRow" class="marquee-row" data-clients="<%= SiteData::CLIENTS.to_json %>"></div>
</section>

<%# 09 — Final CTA %>
<%= render "shared/cta_band", bg: "#fff", h2: t("home.final.h2"), desc: t("home.final.desc"), primary: [ t("common.request_quote"), rfq_path ], secondary: :whatsapp %>
