<% content_for :title, "من نحن — ألمنيوم مزايا" %>
<% content_for :description, "٣٥ عامًا من الألمنيوم السعودي: قصة مصنع مزايا في الرياض منذ ١٩٨٩، قيمنا، ورحلة النمو." %>
<% content_for :nav_active, "about" %>

<section style="position:relative;min-height:62vh;display:flex;align-items:end;background:#0D1744;overflow:hidden">
  <img src="/assets/hero.jpg" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;animation:heroZoom 2.4s ease-out both">
  <div style="position:absolute;inset:0;background:linear-gradient(0deg,rgba(13,23,68,.95) 0%,rgba(13,23,68,.45) 60%,rgba(13,23,68,.55) 100%)"></div>
  <div style="position:relative;z-index:2;max-width:1280px;margin:0 auto;width:100%;padding:150px 48px 70px;box-sizing:border-box">
    <div data-reveal class="kicker">من نحن</div>
    <h1 data-reveal style="margin:0 0 16px;color:#fff;font-size:clamp(40px,4.5vw,64px);font-weight:900;line-height:1.2">٣٥ عامًا من الألمنيوم السعودي</h1>
    <p data-reveal style="margin:0;color:rgba(255,255,255,.8);font-size:19px;line-height:1.8;max-width:640px">من مصنع واحد في الرياض عام ١٩٨٩ إلى الاسم الأول في السلالم والعربات الصناعية بالمملكة وسبعة أسواق تصدير.</p>
  </div>
</section>

<section style="padding:100px 48px;background:#fff">
  <div class="grid-2" style="max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1.1fr .9fr;gap:60px;align-items:center">
    <div data-reveal>
      <h2 style="margin:0 0 20px;color:#192C7B;font-size:40px;font-weight:900">نبذة عن الشركة</h2>
      <p style="margin:0 0 16px;color:#686B70;font-size:17px;line-height:1.9">بدأت مزايا بخط بثق واحد وفكرة بسيطة: منتج ألمنيوم سعودي يضاهي المستورد ويتفوق عليه. اليوم نُشغّل مصنعًا متكاملًا يغطي البثق والتجميع والاختبار والتغليف تحت سقف واحد.</p>
      <p style="margin:0 0 32px;color:#686B70;font-size:17px;line-height:1.9">نخدم ثلاث فئات من العملاء: المقاول الذي يحتاج منتجًا يتحمل الموقع، والموزّع الذي يبحث عن علامة تبيع نفسها، والمشاريع الكبرى التي تحتاج حلولًا مصممة خصيصًا.</p>
      <div style="display:flex;gap:40px;flex-wrap:wrap">
        <div><div style="color:#192C7B;font-size:34px;font-weight:900"><span data-count="35">0</span>+</div><div style="color:#686B70;font-size:14px;margin-top:4px">سنة خبرة</div></div>
        <div><div style="color:#192C7B;font-size:34px;font-weight:900"><span data-count="88">0</span>٪</div><div style="color:#686B70;font-size:14px;margin-top:4px">حصة السوق</div></div>
        <div><div style="color:#192C7B;font-size:34px;font-weight:900"><span data-count="7">0</span></div><div style="color:#686B70;font-size:14px;margin-top:4px">أسواق تصدير</div></div>
      </div>
    </div>
    <div data-reveal style="height:440px;border-radius:24px;overflow:hidden;box-shadow:0 24px 60px rgba(25,44,123,.18)"><img src="/assets/cat-custom.jpg" alt="صورة من المصنع" class="cover" loading="lazy"></div>
  </div>
</section>

