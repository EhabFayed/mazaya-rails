<% content_for :title, t("about.title") %>
<% content_for :description, t("about.description") %>
<% content_for :nav_active, "company" %>
<% profile = SiteData::DOWNLOADS["company-profile"] %>
<style>
  /* About page */
  .story-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:60px;align-items:center}
  .story-img{height:440px;border-radius:24px;overflow:hidden;box-shadow:0 24px 60px rgba(25,44,123,.18)}
  .range-row{flex-direction:row;align-items:center;gap:22px;padding:22px 26px}
  .range-row .range-thumb{width:76px;height:76px;border-radius:16px;overflow:hidden;flex-shrink:0}
  .range-row h3{margin:0 0 4px}
  .range-row .card-link{margin:0;white-space:nowrap}
  .what-card .cat-media{height:280px}
  @media (max-width:960px){.story-grid{grid-template-columns:1fr;gap:32px}.story-img{height:300px}.range-row{flex-wrap:wrap}}
</style>

<%# 01 — Hero %>
<%= render "shared/page_hero",
      crumbs: [ [ t("nav.company"), nil ], [ t("nav.about"), nil ] ],
      label: t("about.hero.label"), h1: t("about.hero.h1"), desc: t("about.hero.desc"),
      primary: [ t("about.profile.cta"), download_path("company-profile"), "company-profile" ],
      secondary: [ t("common.explore_products"), products_path ],
      image: "/assets/hero.jpg" %>

<%# 02 — Story %>
<section id="story" class="section-pad bg-white">
  <div class="wrap story-grid">
    <div data-reveal>
      <div class="kicker-gray"><%= t("about.story.label") %></div>
      <h2 style="margin:0 0 20px;color:#192C7B;font-size:40px;font-weight:900;line-height:1.25"><%= t("about.story.h2") %></h2>
      <p style="margin:0 0 16px;color:#686B70;font-size:17px;line-height:1.9"><%= t("about.story.p1") %></p>
      <p style="margin:0;color:#686B70;font-size:17px;line-height:1.9"><%= t("about.story.p2") %></p>
    </div>
    <div data-reveal class="story-img"><img src="/assets/cat-custom.jpg" alt="" class="cover" loading="lazy"></div>
  </div>
</section>

<%# 03 — Values %>
<section id="values" class="section-pad bg-soft">
  <div class="wrap">
    <%= render "shared/section_head", label: t("about.values.label"), h2: t("about.values.h2"), center: true %>
    <div class="grid-3">
      <% t("about.values.items").each_with_index do |(title, desc), i| %>
      <div data-reveal class="feature-card card-hover">
        <div class="num-badge"><%= num(i + 1) %></div>
        <h3><%= title %></h3>
        <p><%= desc %></p>
      </div>
      <% end %>
    </div>
  </div>
</section>

<%# 04 — Numbers %>
<section id="numbers" class="section-pad bg-navy" style="padding:80px 48px">
  <div class="wrap">
    <%= render "shared/section_head", label: t("about.numbers.label"), h2: t("about.numbers.h2"), dark: true, center: true %>
    <div class="stat-grid">
      <% t("about.numbers.items").each do |big, sub| %>
      <div data-reveal class="stat">
        <div class="stat-num" style="font-size:clamp(28px,2.8vw,38px)"><%= big %></div>
        <div class="stat-sub"><%= sub %></div>
      </div>
      <% end %>
    </div>
  </div>
</section>

<%# 05 — Company profile %>
<section id="profile" class="section-pad bg-white">
  <div data-reveal class="cta-band" style="background:#0D1744">
    <div style="display:flex;align-items:center;gap:32px;flex-wrap:wrap">
      <a data-gate="company-profile" data-gate-title="<%= profile[:title] %>" href="<%= download_path("company-profile") %>" class="catalog-cover" style="width:150px;flex-shrink:0" aria-label="<%= profile[:title] %>">
        <img src="/assets/logo-white.png" alt="">
        <span><%= profile[:title] %></span>
      </a>
      <div style="max-width:560px">
        <div class="kicker" style="margin-bottom:10px"><%= t("about.profile.label") %></div>
        <h2 style="margin:0 0 10px;color:#fff;font-size:30px;font-weight:900"><%= t("about.profile.h2") %></h2>
        <p style="margin:0;color:rgba(255,255,255,.75);font-size:16.5px;line-height:1.8"><%= t("about.profile.desc") %></p>
      </div>
    </div>
    <div style="display:grid;gap:10px;justify-items:center">
      <a data-gate="company-profile" data-gate-title="<%= profile[:title] %>" href="<%= download_path("company-profile") %>" class="btn-white"><%= t("about.profile.cta") %></a>
      <span class="pending"><%= t("about.profile.meta") %></span>
    </div>
  </div>
</section>

<%# 06 — What we do %>
<section id="what" class="section-pad bg-soft">
  <div class="wrap">
    <%= render "shared/section_head", label: t("about.what.label"), h2: t("about.what.h2"), desc: t("about.what.intro"), center: true %>
    <div class="grid-2">
      <a href="<%= products_path %>" data-reveal class="cat-card card-hover-lg what-card">
        <div class="cat-media"><img src="/assets/cat-ladders.jpg" alt="" loading="lazy"><span class="tag tag-ready" style="position:absolute;top:16px;inset-inline-start:16px"><%= t("common.ready") %></span></div>
        <div class="cat-body" style="padding:30px 32px 34px">
          <h3 style="font-size:26px"><%= t("about.what.ready_title") %></h3>
          <p style="font-size:15.5px"><%= t("about.what.ready_desc") %></p>
          <span class="card-link"><%= t("common.explore_products") %> ←</span>
        </div>
      </a>
      <a href="<%= solutions_path %>" data-reveal class="cat-card card-hover-lg what-card">
        <div class="cat-media"><img src="/assets/cat-custom.jpg" alt="" loading="lazy"><span class="tag tag-custom" style="position:absolute;top:16px;inset-inline-start:16px"><%= t("common.custom") %></span></div>
        <div class="cat-body" style="padding:30px 32px 34px">
          <h3 style="font-size:26px"><%= t("about.what.custom_title") %></h3>
          <p style="font-size:15.5px"><%= t("about.what.custom_desc") %></p>
          <span class="card-link"><%= t("about.what.custom_cta") %> ←</span>
        </div>
      </a>
    </div>
  </div>
</section>

<%# 07 — Product range %>
<section id="range" class="section-pad bg-white">
  <div class="wrap">
    <%= render "shared/section_head", label: t("about.range.label"), h2: t("about.range.h2"), link: [ t("about.range.cta"), products_path ] %>
    <div style="display:grid;gap:14px">
      <% @categories.each do |c| %>
      <a href="<%= product_category_path(c[:slug]) %>" data-reveal class="feature-card soft card-hover range-row">
        <div class="range-thumb"><img src="<%= c[:image] %>" alt="" class="cover" loading="lazy"></div>
        <div style="flex:1;min-width:220px">
          <h3><%= c[:name] %></h3>
          <p><%= c[:about] %></p>
        </div>
        <span class="card-link"><%= t("common.explore_category") %> ←</span>
      </a>
      <% end %>
    </div>
    <div data-reveal style="text-align:center;margin-top:40px"><a href="<%= products_path %>" class="btn-outline"><%= t("about.range.cta") %> ←</a></div>
  </div>
</section>

<%# 08 — Manufacturing capabilities %>
<section id="capabilities" class="section-pad bg-soft">
  <div class="wrap">
    <%= render "shared/section_head", label: t("about.capabilities.label"), h2: t("about.capabilities.h2"), desc: t("about.capabilities.intro"), center: true %>
    <div class="grid-4">
      <% t("about.capabilities.items").each_with_index do |(title, desc), i| %>
      <div data-reveal class="step">
        <div class="step-num" style="color:#192C7B"><%= num(i + 1) %></div>
        <h3><%= title %></h3>
        <p><%= desc %></p>
      </div>
      <% end %>
    </div>
  </div>
</section>

<%# 09 — Closing CTA %>
<%= render "shared/cta_band", label: t("about.final.label"), h2: t("about.final.h2"), desc: t("about.final.desc"), primary: [ t("about.final.primary"), products_path ], secondary: [ t("about.final.secondary"), rfq_path ] %>
