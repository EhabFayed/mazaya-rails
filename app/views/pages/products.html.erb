<% content_for :title, "المنتجات — ألمنيوم مزايا" %>
<% content_for :description, "سلالم وعربات صناعية وحلول ألمنيوم مخصصة — ثلاث فئات تُصنع وتُختبر في مصنعنا بالرياض." %>
<% content_for :nav_active, "products" %>

<section style="background:#0D1744;padding:170px 48px 80px">
  <div style="max-width:1280px;margin:0 auto">
    <div data-reveal class="kicker">المنتجات</div>
    <h1 data-reveal style="margin:0 0 16px;color:#fff;font-size:clamp(40px,4.5vw,64px);font-weight:900">ثلاث فئات، معيار واحد</h1>
    <p data-reveal style="margin:0;color:rgba(255,255,255,.75);font-size:19px;line-height:1.8;max-width:600px">كل منتج يخرج من نفس المصنع، بنفس الخامة، وبنفس اختبارات التحمل. اختر فئتك.</p>
  </div>
</section>

<section style="padding:80px 48px 100px;background:#F4F5F7">
  <div style="max-width:1280px;margin:0 auto;display:grid;gap:32px">
    
    <a href="/ladders" data-reveal class="card-hover-lg grid-2" style="display:grid;grid-template-columns:1.1fr 1fr;background:#fff;border-radius:26px;overflow:hidden;min-height:380px;box-shadow:0 4px 20px rgba(25,44,123,.07);color:inherit">
      <div style="position:relative;overflow:hidden;min-height:300px"><img src="/assets/cat-ladders.jpg" alt="السلالم" class="cover" loading="lazy"></div>
      <div style="display:flex;flex-direction:column;justify-content:center;gap:16px;padding:56px">
        <div style="display:flex;align-items:center;gap:14px">
          <span style="color:#B9C6F2;font-size:15px;font-weight:900">٠١</span>
          <span style="color:#686B70;font-size:13px;font-weight:700;letter-spacing:2px">الأكثر مبيعًا</span>
        </div>
        <h2 style="margin:0;color:#192C7B;font-size:38px;font-weight:900">السلالم</h2>
        <p style="margin:0;color:#686B70;font-size:16.5px;line-height:1.85;max-width:440px">الفئة الأولى تصنيعًا وتصديرًا. تشكيلة كاملة تغطي الاستخدام المنزلي والمهني والصناعي، وكل درجة تُختبر تحت حمل يفوق الاستخدام الفعلي.</p>
        <div style="display:flex;align-items:center;gap:10px;color:#192C7B;font-size:16px;font-weight:800;margin-top:8px">اكتشف الفئة <span style="font-size:20px">←</span></div>
      </div>
    </a>
    <a href="/carts" data-reveal class="card-hover-lg grid-2" style="display:grid;grid-template-columns:1.1fr 1fr;background:#fff;border-radius:26px;overflow:hidden;min-height:380px;box-shadow:0 4px 20px rgba(25,44,123,.07);color:inherit">
      <div style="position:relative;overflow:hidden;min-height:300px"><img src="/assets/cat-carts.jpg" alt="العربات الصناعية" class="cover" loading="lazy"></div>
      <div style="display:flex;flex-direction:column;justify-content:center;gap:16px;padding:56px">
        <div style="display:flex;align-items:center;gap:14px">
          <span style="color:#B9C6F2;font-size:15px;font-weight:900">٠٢</span>
          <span style="color:#686B70;font-size:13px;font-weight:700;letter-spacing:2px">منتج التركيز</span>
        </div>
        <h2 style="margin:0;color:#192C7B;font-size:38px;font-weight:900">العربات الصناعية</h2>
        <p style="margin:0;color:#686B70;font-size:16.5px;line-height:1.85;max-width:440px">عربات نقل بأحمال مختبرة حتى ٧٥٠ كجم، مصممة لبيئات العمل الشاقة: المستودعات، المصانع، ومواقع الإنشاء.</p>
        <div style="display:flex;align-items:center;gap:10px;color:#192C7B;font-size:16px;font-weight:800;margin-top:8px">اكتشف الفئة <span style="font-size:20px">←</span></div>
      </div>
    </a>
    <a href="/custom" data-reveal class="card-hover-lg grid-2" style="display:grid;grid-template-columns:1.1fr 1fr;background:#fff;border-radius:26px;overflow:hidden;min-height:380px;box-shadow:0 4px 20px rgba(25,44,123,.07);color:inherit">
      <div style="position:relative;overflow:hidden;min-height:300px"><img src="/assets/cat-custom.jpg" alt="حلول مخصصة" class="cover" loading="lazy"></div>
      <div style="display:flex;flex-direction:column;justify-content:center;gap:16px;padding:56px">
        <div style="display:flex;align-items:center;gap:14px">
          <span style="color:#B9C6F2;font-size:15px;font-weight:900">٠٣</span>
          <span style="color:#686B70;font-size:13px;font-weight:700;letter-spacing:2px">للمشاريع الكبرى</span>
        </div>
        <h2 style="margin:0;color:#192C7B;font-size:38px;font-weight:900">حلول مخصصة</h2>
        <p style="margin:0;color:#686B70;font-size:16.5px;line-height:1.85;max-width:440px">تصنيع حسب الطلب يبدأ باستشارة هندسية وينتهي بتسليم في الموقع. للمشاريع التي لا يناسبها الجاهز.</p>
        <div style="display:flex;align-items:center;gap:10px;color:#192C7B;font-size:16px;font-weight:800;margin-top:8px">اكتشف الفئة <span style="font-size:20px">←</span></div>
      </div>
    </a>
  </div>
</section>

<section style="padding:0 48px 100px;background:#F4F5F7">
  <div data-reveal class="cta-band" style="padding:56px 64px">
    <div>
      <h2 style="margin:0 0 10px;color:#fff;font-size:30px;font-weight:900">لم تجد ما تبحث عنه؟</h2>
      <p style="margin:0;color:rgba(255,255,255,.75);font-size:16.5px">نصنع حسب الطلب للمشاريع الكبرى — من الاستشارة إلى التسليم.</p>
    </div>
    <a href="/custom" class="btn-white">اطلب حلًا مخصصًا</a>
  </div>
</section>
