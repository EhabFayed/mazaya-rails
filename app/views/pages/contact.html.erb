<% content_for :title, "تواصل معنا — ألمنيوم مزايا" %>
<% content_for :description, "اطلب عرض سعر خلال دقيقة — نموذج قصير يصل لفريق المبيعات والرد في نفس اليوم." %>

<section style="background:#0D1744;padding:170px 48px 80px">
  <div style="max-width:1280px;margin:0 auto">
    <div data-reveal class="kicker">تواصل معنا</div>
    <h1 data-reveal style="margin:0 0 16px;color:#fff;font-size:clamp(40px,4.5vw,64px);font-weight:900">اطلب عرض سعر خلال دقيقة</h1>
    <p data-reveal style="margin:0;color:rgba(255,255,255,.75);font-size:19px;line-height:1.8;max-width:600px">نموذج قصير يصل مباشرة لفريق المبيعات — والرد في نفس اليوم.</p>
  </div>
</section>

<section style="padding:90px 48px;background:#F4F5F7">
  <div class="grid-2" style="max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:start">
    <form data-reveal data-wa-form="طلب عرض سعر من الموقع" style="background:#fff;border-radius:22px;padding:40px;box-shadow:0 10px 40px rgba(25,44,123,.1);display:grid;gap:16px">
      <input placeholder="الاسم" class="field">
      <input placeholder="رقم الجوال" class="field" inputmode="tel">
      <select class="field">
        <option>نوع الاهتمام</option><option>منتج</option><option>شراكة توزيع</option><option>مشروع</option>
      </select>
      <textarea placeholder="رسالتك (اختياري)" rows="4" class="field" style="resize:vertical"></textarea>
      <button type="submit" class="form-btn">إرسال الطلب</button>
    </form>
    <div style="display:grid;gap:18px">
      <a data-reveal data-wa href="#" style="display:flex;align-items:center;gap:18px;background:#25D366;border-radius:20px;padding:26px 30px;color:#fff;transition:transform .3s" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='none'">
        <div style="width:54px;height:54px;border-radius:50%;background:rgba(255,255,255,.22);display:flex;align-items:center;justify-content:center"><svg width="26" height="26" viewBox="0 0 24 24" fill="#fff" aria-hidden="true" style="flex-shrink:0"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg></div>
        <div>
          <div style="font-size:18px;font-weight:800">واتساب فوري</div>
          <div dir="ltr" style="font-size:15px;opacity:.9;unicode-bidi:isolate;text-align:end" data-wa-display></div>
        </div>
      </a>
      <div data-reveal style="background:#fff;border-radius:20px;padding:26px 30px">
        <div style="color:#192C7B;font-size:17px;font-weight:800;margin-bottom:6px">عنوان المصنع</div>
        <div style="color:#686B70;font-size:15px;line-height:1.8">المنطقة الصناعية، الرياض، المملكة العربية السعودية</div>
      </div>
      <div data-reveal style="background:#fff;border-radius:20px;padding:26px 30px">
        <div style="color:#192C7B;font-size:17px;font-weight:800;margin-bottom:6px">ساعات العمل</div>
        <div style="color:#686B70;font-size:15px;line-height:1.8">السبت – الخميس، ٨ صباحًا – ٥ مساءً</div>
      </div>
      <div data-reveal style="height:230px;border-radius:20px;overflow:hidden;position:relative">
        <div class="ph-slot">خريطة موقع المصنع</div>
        <div style="position:absolute;bottom:16px;inset-inline-start:18px;background:rgba(13,23,68,.85);color:#fff;font-size:13px;font-weight:700;border-radius:999px;padding:8px 16px;pointer-events:none">📍 موقع المصنع على الخريطة</div>
      </div>
    </div>
  </div>
</section>
