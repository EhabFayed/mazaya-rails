<% content_for :title, t("contact.title") %>
<% content_for :description, t("contact.description") %>
<% content_for :nav_active, "contact" %>
<%# Department -> preselected inquiry type (indexes into SiteData::INQUIRY_TYPES) %>
<% dept_interest = { "sales" => @inquiry_types[0], "export" => @inquiry_types[2], "technical" => @inquiry_types[3], "partners" => @inquiry_types[4] } %>
<% selected_interest = dept_interest[@dept] %>
<style>
  /* Contact page */
  .contact-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:50px;align-items:start}
  .dept-card.is-active{box-shadow:0 0 0 2.5px #192C7B}
  .dept-card .card-link{margin-top:auto;padding-top:14px}
  .loc-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:24px;align-items:stretch}
  .map-box{position:relative;min-height:420px;border-radius:24px;overflow:hidden;background:#E9EBF0}
  .map-box iframe{position:absolute;inset:0;width:100%;height:100%;border:0;display:block}
  /* location + contact details (address, hours, phone, WhatsApp, email) in one card */
  .loc-card{background:#fff;border-radius:24px;padding:10px 30px 28px;display:flex;flex-direction:column;box-shadow:0 10px 40px rgba(25,44,123,.06)}
  .info-row{display:flex;flex-direction:column;gap:6px;padding:16px 0;border-bottom:1px solid #E6E8EC}
  .info-pair{display:grid;grid-template-columns:1fr 1fr;gap:0 24px;border-bottom:1px solid #E6E8EC}
  @media (max-width:440px){.info-pair{grid-template-columns:1fr}.info-pair .info-row+.info-row{border-top:1px solid #E6E8EC}}
  .info-pair .info-row{border-bottom:none}
  .info-label{color:#192C7B;font-size:14px;font-weight:800}
  .info-value{color:#686B70;font-size:15.5px;line-height:1.7}
  .info-link{color:#2A44B8;font-weight:700;unicode-bidi:isolate;white-space:nowrap;text-underline-offset:3px}
  .info-link:hover{color:#192C7B;text-decoration:underline}
  .info-link:focus-visible{outline:2px solid #2A44B8;outline-offset:2px;border-radius:4px}
  .loc-card > .info-row:nth-last-child(2){border-bottom:none}
  .loc-actions{margin-top:auto;padding-top:20px;display:flex;gap:12px;flex-wrap:wrap}
  .loc-actions > *{flex:1 1 auto;justify-content:center}
  @media (max-width:960px){.contact-grid,.loc-grid{grid-template-columns:1fr;gap:32px}.map-box{min-height:300px}}
</style>

<%# 01 — Hero %>
<%= render "shared/page_hero",
      crumbs: [ [ t("nav.contact"), nil ] ],
      label: t("contact.hero.label"), h1: t("contact.hero.h1"), desc: t("contact.hero.desc"),
      primary: [ t("contact.hero.primary"), "#form" ], secondary: :whatsapp %>

<%# 02 — Departments %>
<section id="departments" class="section-pad bg-soft">
  <div class="wrap">
    <%= render "shared/section_head", label: t("contact.departments.label"), h2: t("contact.departments.h2"), center: true %>
    <div class="grid-4">
      <% @departments.each do |d| %>
      <a href="#form" data-dept="<%= d[:key] %>" data-reveal class="feature-card card-hover dept-card<%= ' is-active' if @dept == d[:key] %>">
        <h3><%= d[:name] %></h3>
        <p><%= d[:desc] %></p>
        <span class="card-link"><%= t("contact.form.label") %> ←</span>
      </a>
      <% end %>
    </div>
  </div>
</section>

<%# 03 — Contact form %>
<section id="form" class="section-pad bg-white">
  <div class="wrap contact-grid">
    <div data-reveal>
      <div class="kicker-gray"><%= t("contact.form.label") %></div>
      <h2 style="margin:0 0 16px;color:#192C7B;font-size:40px;font-weight:900;line-height:1.25"><%= t("contact.form.h2") %></h2>
      <p style="margin:0 0 28px;color:#686B70;font-size:17px;line-height:1.85"><%= t("contact.form.desc") %></p>
      <ul class="checklist" style="margin-bottom:28px">
        <% @departments.each do |d| %><li style="background:#F4F5F7"><span><b style="color:#192C7B"><%= d[:name] %></b> — <%= d[:desc] %></span></li><% end %>
      </ul>
      <p style="margin:0 0 14px;color:#9AA0A8;font-size:13.5px"><%= t("common.required_hint") %></p>
      <a data-wa href="#" class="btn-wa"><%= render "shared/wa_icon", size: 18 %> <%= t("common.whatsapp_direct") %></a>
    </div>

    <form data-reveal data-lead-form data-kind="contact" data-source="contact-page" data-wa-title="<%= t('contact.form.cta') %>" class="form-card" novalidate="false">
      <input type="text" name="mz_trap" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <input type="hidden" name="department" data-label="<%= t("nav.departments") %>" value="<%= @dept %>">
      <div>
        <label class="field-label" for="lead_name"><%= t("contact.form.name") %> *</label>
        <input id="lead_name" name="lead[name]" class="field" placeholder="<%= t("contact.form.name_ph") %>" data-label="<%= t("contact.form.name") %>" required autocomplete="name">
      </div>
      <div class="grid-2" style="gap:14px">
        <div>
          <label class="field-label" for="lead_phone"><%= t("contact.form.phone") %> *</label>
          <input id="lead_phone" name="lead[phone]" class="field" placeholder="<%= t("contact.form.phone_ph") %>" data-label="<%= t("contact.form.phone") %>" inputmode="tel" autocomplete="tel" required>
        </div>
        <div>
          <label class="field-label" for="lead_email"><%= t("contact.form.email") %></label>
          <input id="lead_email" name="lead[email]" type="email" class="field" placeholder="<%= t("contact.form.email_ph") %>" data-label="<%= t("contact.form.email") %>" autocomplete="email">
        </div>
      </div>
      <div class="grid-2" style="gap:14px">
        <div>
          <label class="field-label" for="lead_company"><%= t("contact.form.company") %></label>
          <input id="lead_company" name="company" class="field" placeholder="<%= t("contact.form.company_ph") %>" data-label="<%= t("contact.form.company") %>" autocomplete="organization">
        </div>
        <div>
          <label class="field-label" for="lead_interest"><%= t("contact.form.type") %> *</label>
          <select id="lead_interest" name="lead[interest]" class="field" data-label="<%= t("contact.form.type") %>" required>
            <option value=""><%= t("contact.form.type") %></option>
            <% @inquiry_types.each do |type| %><option value="<%= type %>"<%= ' selected' if type == selected_interest %>><%= type %></option><% end %>
          </select>
        </div>
      </div>
      <div>
        <label class="field-label" for="lead_message"><%= t("contact.form.message") %></label>
        <textarea id="lead_message" name="lead[message]" class="field" rows="5" placeholder="<%= t("contact.form.message_ph") %>" data-label="<%= t("contact.form.message") %>"></textarea>
      </div>
      <label class="upload-box">
        <%= t("contact.form.attachment") %>
        <input type="file" name="file">
      </label>
      <button type="submit" class="form-btn"><%= t("contact.form.cta") %></button>
      <div class="form-msg" data-form-msg></div>
      <div class="form-success">
        <h3><%= t("common.sent_title") %></h3>
        <p><%= t("common.sent_body") %></p>
        <a data-wa-prefill href="#" class="btn-wa" target="_blank" rel="noopener"><%= render "shared/wa_icon", size: 18 %> <%= t("common.whatsapp") %></a>
      </div>
    </form>
  </div>
</section>

<%# 04 — Location %>
<section id="location" class="section-pad bg-soft">
  <div class="wrap">
    <%= render "shared/section_head", label: t("contact.location.label"), h2: t("contact.location.h2") %>
    <div class="loc-grid">
      <div data-reveal class="map-box">
        <% if SiteData::MAP_EMBED.present? %>
          <iframe src="<%= SiteData::MAP_EMBED %>" title="<%= t("contact.location.h2") %>" loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade"></iframe>
        <% else %>
          <div class="ph-slot"><%= t("contact.location.map_pending") %></div>
        <% end %>
      </div>
      <div data-reveal class="loc-card">
        <div class="info-row">
          <span class="info-label"><%= t("contact.location.address") %></span>
          <span class="info-value"><%= SiteData::ADDRESS.presence || raw("<span class=\"pending\">#{ERB::Util.h(t("contact.location.address_pending"))}</span>") %></span>
        </div>
        <div class="info-row">
          <span class="info-label"><%= t("contact.location.hours") %></span>
          <span class="info-value"><%= SiteData::HOURS.presence || raw("<span class=\"pending\">#{ERB::Util.h(t("contact.location.hours_pending"))}</span>") %></span>
        </div>
        <div class="info-pair">
          <div class="info-row">
            <span class="info-label"><%= t("contact.whatsapp.phone") %></span>
            <span class="info-value"><% if SiteData::PHONE.present? %><a href="tel:<%= SiteData::PHONE.delete('^0-9+') %>" dir="ltr" class="info-link"><%= SiteData::PHONE %></a><% else %><span class="pending"><%= t("contact.whatsapp.phone_pending") %></span><% end %></span>
          </div>
          <div class="info-row">
            <span class="info-label"><%= t("footer.whatsapp") %></span>
            <span class="info-value"><a data-wa href="#" dir="ltr" class="info-link" data-wa-display><%= SiteData::WHATSAPP_DISPLAY %></a></span>
          </div>
        </div>
        <div class="info-row">
          <span class="info-label"><%= t("contact.whatsapp.email") %></span>
          <span class="info-value"><% if SiteData::EMAILS.any? %><%= safe_join(SiteData::EMAILS.map { |e| link_to(e, "mailto:#{e}", dir: "ltr", class: "info-link") }, tag.br) %><% else %><span class="pending"><%= t("contact.whatsapp.email_pending") %></span><% end %></span>
        </div>
        <div class="loc-actions">
          <% if SiteData::MAP_LINK.present? %>
            <a href="<%= SiteData::MAP_LINK %>" target="_blank" rel="noopener" class="btn-navy"><%= t("contact.location.cta") %></a>
          <% else %>
            <span class="btn-disabled" aria-disabled="true"><%= t("contact.location.cta") %></span>
          <% end %>
          <a data-wa href="#" class="btn-wa"><%= render "shared/wa_icon", size: 20 %> <%= t("common.whatsapp") %></a>
        </div>
      </div>
    </div>
  </div>
</section>


<%# 06 — Quick links %>
<section id="quick" class="section-pad bg-white">
  <div class="wrap">
    <%= render "shared/section_head", label: t("contact.quick.label"), h2: t("contact.quick.h2"), center: true %>
    <div class="grid-4">
      <% t("contact.quick.items").each do |title, desc, cta, href| %>
      <a href="<%= href %>" data-reveal class="feature-card soft card-hover">
        <h3><%= title %></h3>
        <p style="margin-bottom:18px"><%= desc %></p>
        <span class="card-link"><%= cta %> ←</span>
      </a>
      <% end %>
    </div>
  </div>
</section>

<% content_for :page_script do %>
<script>
// Department cards: preselect the inquiry type and scroll to the form without a reload.
(function () {
  var map = <%= raw dept_interest.to_json %>;
  var sel = document.getElementById('lead_interest');
  var hidden = document.querySelector('form[data-lead-form] input[name=department]');
  var cards = document.querySelectorAll('[data-dept]');
  cards.forEach(function (a) {
    a.addEventListener('click', function () {
      var key = a.getAttribute('data-dept');
      if (sel && map[key]) sel.value = map[key];
      if (hidden) hidden.value = key;
      cards.forEach(function (x) { x.classList.toggle('is-active', x === a); });
    });
  });
})();
</script>
<% end %>
