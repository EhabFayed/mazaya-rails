<% content_for :title, "شراكة معنا — ألمنيوم مزايا" %>
<% content_for :description, "انضم إلى شبكة ٣٥٠+ موزّعًا معتمدًا: هوامش واضحة، حماية مناطق، ودعم تسويقي ٨٠/٢٠." %>
<% content_for :nav_active, "partners" %>

<section style="background:#0D1744;padding:170px 48px 80px;position:relative;overflow:hidden">
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse 50% 60% at 85% 50%,rgba(185,198,242,.16),transparent 70%)"></div>
  <div class="grid-2" style="position:relative;max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1.1fr .9fr;gap:60px;align-items:center">
    <div>
      <div data-reveal class="kicker">شراكة معنا</div>
      <h1 data-reveal style="margin:0 0 16px;color:#fff;font-size:clamp(38px,4.2vw,58px);font-weight:900;line-height:1.25">انضم إلى شبكة من ٣٥٠+ موزّعًا</h1>
      <p data-reveal style="margin:0 0 32px;color:rgba(255,255,255,.75);font-size:18px;line-height:1.8">منتج يبيع نفسه باسمه، وهوامش واضحة، ودعم لا يتوقف عند التوقيع.</p>
      <a data-reveal href="#apply" class="btn-white" style="font-size:17px;padding:16px 36px">قدّم كموزّع الآن</a>
    </div>
    <div data-reveal class="grid-2m" style="display:grid;grid-template-columns:1fr 1fr;gap:18px;text-align:center">
      
      <div style="background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:18px;padding:28px 20px"><div style="color:#fff;font-size:34px;font-weight:900"><span data-count="350">0</span>+</div><div style="color:rgba(255,255,255,.65);font-size:14px;margin-top:6px">موزّع معتمد</div></div>
      <div style="background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:18px;padding:28px 20px"><div style="color:#fff;font-size:34px;font-weight:900"><span data-count="7">0</span></div><div style="color:rgba(255,255,255,.65);font-size:14px;margin-top:6px">أسواق تصدير</div></div>
      <div style="background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:18px;padding:28px 20px"><div style="color:#fff;font-size:34px;font-weight:900"><span data-count="88">0</span>٪</div><div style="color:rgba(255,255,255,.65);font-size:14px;margin-top:6px">حصة السوق</div></div>
      <div style="background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:18px;padding:28px 20px"><div style="color:#fff;font-size:34px;font-weight:900">٢٤ س</div><div style="color:rgba(255,255,255,.65);font-size:14px;margin-top:6px">رد على طلبات الانضمام</div></div>
    </div>
  </div>
</section>

<section style="padding:100px 48px;background:#F4F5F7">
  <div style="max-width:1280px;margin:0 auto">
    <div data-reveal style="margin-bottom:48px">
      <h2 style="margin:0;color:#192C7B;font-size:40px;font-weight:900">ماذا تكسب كموزّع مزايا؟</h2>
    </div>
    <div class="grid-2m" style="display:grid;grid-template-columns:repeat(4,1fr);gap:22px">
      
      <div data-reveal class="card-hover" style="background:#fff;border-radius:20px;padding:32px 28px">
        <div style="width:52px;height:52px;border-radius:14px;background:#192C7B;color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:900;margin-bottom:18px">١</div>
        <h3 style="margin:0 0 10px;color:#192C7B;font-size:19px;font-weight:800">هامش ربح واضح</h3>
        <p style="margin:0;color:#686B70;font-size:14.5px;line-height:1.8">تسعير ثابت معلن للموزّعين، بدون مفاجآت في منتصف السنة.</p>
      </div>
      <div data-reveal class="card-hover" style="background:#fff;border-radius:20px;padding:32px 28px">
        <div style="width:52px;height:52px;border-radius:14px;background:#192C7B;color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:900;margin-bottom:18px">٢</div>
        <h3 style="margin:0 0 10px;color:#192C7B;font-size:19px;font-weight:800">حماية مناطق</h3>
        <p style="margin:0;color:#686B70;font-size:14.5px;line-height:1.8">سياسة توزيع جغرافي تحمي استثمارك في منطقتك.</p>
      </div>
      <div data-reveal class="card-hover" style="background:#fff;border-radius:20px;padding:32px 28px">
        <div style="width:52px;height:52px;border-radius:14px;background:#192C7B;color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:900;margin-bottom:18px">٣</div>
        <h3 style="margin:0 0 10px;color:#192C7B;font-size:19px;font-weight:800">توريد سريع</h3>
        <p style="margin:0;color:#686B70;font-size:14.5px;line-height:1.8">مخزون محلي دائم — المصنع هنا وليس وراء البحر.</p>
      </div>
      <div data-reveal class="card-hover" style="background:#fff;border-radius:20px;padding:32px 28px">
        <div style="width:52px;height:52px;border-radius:14px;background:#192C7B;color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:900;margin-bottom:18px">٤</div>
        <h3 style="margin:0 0 10px;color:#192C7B;font-size:19px;font-weight:800">منتج معروف</h3>
        <p style="margin:0;color:#686B70;font-size:14.5px;line-height:1.8">٣٥ سنة من الثقة تعني عميلًا يسأل عن الاسم بنفسه.</p>
      </div>
    </div>
    <div data-reveal style="margin-top:26px;background:#192C7B;border-radius:20px;padding:34px 40px;display:flex;align-items:center;gap:26px;flex-wrap:wrap">
      <div style="color:#fff;font-size:44px;font-weight:900">٨٠/٢٠</div>
      <div>
        <div style="color:#fff;font-size:18px;font-weight:800;margin-bottom:4px">حزمة الدعم التسويقي</div>
        <div style="color:rgba(255,255,255,.7);font-size:15px;line-height:1.7">مواد جاهزة، حملات مشتركة، وأولوية مشاركة في المعارض — نتحمل النصيب الأكبر.</div>
      </div>
    </div>
  </div>
</section>

<section id="apply" style="padding:100px 48px;background:#fff">
  <div class="grid-2" style="max-width:1080px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:start">
    <div data-reveal>
      <h2 style="margin:0 0 18px;color:#192C7B;font-size:38px;font-weight:900">قدّم كموزّع</h2>
      <p style="margin:0 0 28px;color:#686B70;font-size:16.5px;line-height:1.8">نموذج واحد قصير — يصل مباشرة لفريق الشراكات، والرد خلال يوم عمل.</p>
      <div style="display:grid;gap:16px">
        
        <div style="display:flex;gap:16px;align-items:start">
          <div style="width:40px;height:40px;border-radius:12px;background:#F4F5F7;color:#192C7B;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:900;flex-shrink:0">١</div>
          <div>
            <div style="color:#192C7B;font-weight:800;font-size:16px">أرسل النموذج</div>
            <div style="color:#686B70;font-size:14.5px;margin-top:3px;line-height:1.7">بياناتك الأساسية ونشاطك الحالي.</div>
          </div>
        </div>
        <div style="display:flex;gap:16px;align-items:start">
          <div style="width:40px;height:40px;border-radius:12px;background:#F4F5F7;color:#192C7B;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:900;flex-shrink:0">٢</div>
          <div>
            <div style="color:#192C7B;font-weight:800;font-size:16px">مكالمة تعريفية</div>
            <div style="color:#686B70;font-size:14.5px;margin-top:3px;line-height:1.7">فريق الشراكات يتصل خلال يوم عمل.</div>
          </div>
        </div>
        <div style="display:flex;gap:16px;align-items:start">
          <div style="width:40px;height:40px;border-radius:12px;background:#F4F5F7;color:#192C7B;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:900;flex-shrink:0">٣</div>
          <div>
            <div style="color:#192C7B;font-weight:800;font-size:16px">اعتماد وانطلاق</div>
            <div style="color:#686B70;font-size:14.5px;margin-top:3px;line-height:1.7">اتفاقية، تدريب على المنتجات، وأول شحنة.</div>
          </div>
        </div>
      </div>
    </div>
    <form data-reveal data-wa-form="طلب انضمام موزّع من الموقع" style="background:#F4F5F7;border-radius:22px;padding:38px;display:grid;gap:16px">
      <input placeholder="الاسم الكامل" class="field" style="background:#fff">
      <input placeholder="اسم المنشأة التجارية" class="field" style="background:#fff">
      <div class="grid-2m" style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
        <input placeholder="المدينة" class="field" style="background:#fff">
        <input placeholder="رقم الجوال" class="field" style="background:#fff" inputmode="tel">
      </div>
      <select class="field" style="background:#fff">
        <option>نشاطك الحالي</option><option>تجارة مواد بناء</option><option>أدوات ومعدات</option><option>تجزئة</option><option>أخرى</option>
      </select>
      <button type="submit" class="form-btn">أرسل طلب الانضمام</button>
      <div style="color:#9AA0A8;font-size:13px;text-align:center">بالإرسال أنت توافق على تواصل فريقنا معك.</div>
    </form>
  </div>
</section>
