<% content_for :title, "حلول مخصصة — ألمنيوم مزايا" %>
<% content_for :description, "تصنيع ألمنيوم حسب الطلب للمشاريع الكبرى: استشارة، تصميم هندسي، تصنيع، وتسليم في الموقع." %>
<% content_for :nav_active, "products" %>

<section style="background:#0D1744;padding:170px 48px 80px;position:relative;overflow:hidden">
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse 55% 65% at 82% 40%,rgba(185,198,242,.16),transparent 70%)"></div>
  <div style="position:relative;max-width:1280px;margin:0 auto">
    <div data-reveal class="crumb"><a href="/products">المنتجات</a><span style="color:rgba(255,255,255,.4)">/</span><span>حلول مخصصة</span></div>
    <h1 data-reveal style="margin:0 0 16px;color:#fff;font-size:clamp(40px,4.5vw,62px);font-weight:900">مشروعك لا يشبه غيره؟<br>منتجك كذلك.</h1>
    <p data-reveal style="margin:0;color:rgba(255,255,255,.75);font-size:19px;line-height:1.8;max-width:620px">للمشاريع الكبرى التي لا تناسبها الحلول الجاهزة: نصمم ونبثق ونصنع حسب مواصفاتك — داخل مصنعنا بالكامل.</p>
  </div>
</section>

