        </div>
        <div data-reveal style="position:relative;text-align:center">
          <div style="width:88px;height:88px;border-radius:50%;background:#192C7B;color:#fff;display:flex;align-items:center;justify-content:center;font-size:30px;font-weight:900;margin:0 auto 22px;box-shadow:0 12px 30px rgba(25,44,123,.3);position:relative;z-index:1">٤</div>
          <h3 style="margin:0 0 10px;color:#192C7B;font-size:21px;font-weight:800">تسليم</h3>
