<%# Extended footer (copy deck §10): full sitemap, catalog entry, contact by department, social. %>
<footer class="site-footer">
  <div class="footer-inner">
    <div class="trust-strip">
      <span class="trust-label"><%= t("footer.trust") %></span>
      <% SiteData::CLIENTS.each do |c| %>
      <span class="trust-item"><span class="trust-logo" style="background:<%= c[:bg] %>"><img src="<%= c[:logo] %>" alt="<%= c[:name] %>"></span><%= c[:name] %></span>
      <% end %>
    </div>

    <div class="footer-grid footer-grid-6">
      <div class="footer-brand">
        <img src="/assets/logo-white.png" alt="<%= t("brand") %>">
        <p><%= t("footer.about_blurb") %></p>
        <div class="social-row">
          <% SiteData::SOCIAL.each do |s| %><a href="<%= s[:url] %>" class="social" title="<%= s[:label] %>" aria-label="<%= s[:label] %>" target="_blank" rel="noopener"><%= s[:abbr] %></a><% end %>
        </div>
      </div>

      <div>
        <div class="footer-head"><%= t("footer.company_title") %></div>
        <div class="footer-links">
          <a href="<%= about_path %>" class="footer-link"><%= t("nav.about") %></a>
          <a href="<%= quality_path %>" class="footer-link"><%= t("nav.quality_page") %></a>
          <a href="<%= safety_path %>" class="footer-link"><%= t("nav.safety_page") %></a>
          <a href="<%= original_path %>" class="footer-link"><%= t("nav.original") %></a>
          <a href="<%= news_path %>" class="footer-link"><%= t("nav.news") %></a>
        </div>
      </div>

      <div>
        <div class="footer-head"><%= t("footer.business_title") %></div>
        <div class="footer-links">
          <a href="<%= solutions_path %>" class="footer-link"><%= t("nav.custom_solutions") %></a>
          <a href="<%= projects_path %>" class="footer-link"><%= t("nav.projects") %></a>
          <a href="<%= catalog_path %>" class="footer-link"><%= t("nav.ecatalog") %></a>
          <a href="<%= rfq_path %>" class="footer-link"><%= t("nav.rfq") %></a>
          <a href="<%= partners_path %>" class="footer-link"><%= t("nav.partner") %></a>
        </div>
      </div>

      <div>
        <div class="footer-head"><%= t("footer.products_title") %></div>
        <div class="footer-links">
          <% SiteData::CATEGORIES.each do |c| %><a href="<%= product_category_path(c[:slug]) %>" class="footer-link"><%= c[:name] %></a><% end %>
        </div>
      </div>

      <div>
        <div class="footer-head"><%= t("footer.contact_title") %></div>
        <div class="footer-links">
          <a href="<%= contact_path(dept: 'sales') %>#form" class="footer-link"><%= t("footer.sales") %></a>
          <a href="<%= contact_path(dept: 'export') %>#form" class="footer-link"><%= t("footer.export") %></a>
          <a href="<%= contact_path(dept: 'technical') %>#form" class="footer-link"><%= t("footer.technical") %></a>
          <a data-wa href="#" class="footer-link"><%= t("footer.whatsapp") %> <span dir="ltr" style="unicode-bidi:isolate" data-wa-display></span></a>
          <a href="#social" class="footer-link"><%= t("footer.social") %></a>
        </div>
      </div>

      <div class="footer-catalog">
        <div class="footer-head"><%= t("footer.catalog_title") %></div>
        <a data-gate="catalog-full" href="<%= download_path("catalog-full") %>" class="catalog-cover" aria-label="<%= t("footer.catalog_headline") %>">
          <img src="/assets/logo-white.png" alt="">
          <span><%= SiteData::DOWNLOADS["catalog-full"][:title] %></span>
        </a>
        <p class="catalog-blurb"><%= t("footer.catalog_headline") %> <%= t("footer.catalog_desc") %></p>
        <a data-gate="catalog-full" href="<%= download_path("catalog-full") %>" class="footer-cta"><%= t("common.download_catalog") %> ←</a>
      </div>
    </div>

    <div class="footer-bottom">
      <span><%= t("footer.rights", year: Date.current.year) %></span>
      <span><%= SiteData::ADDRESS || t("contact.location.address_pending") %> · <%= SiteData::HOURS || t("contact.location.hours_pending") %></span>
      <span><%= t("tagline") %></span>
    </div>
  </div>
</footer>
<a data-wa href="#" aria-label="<%= t('footer.whatsapp') %>" class="wa-fab"><%= render "shared/wa_icon", size: 30 %></a>
