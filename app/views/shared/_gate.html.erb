<%# Gated-download modal (IA doc §06): 3 fields, file opens immediately, not asked again this session. %>
<div id="gate" class="gate" hidden role="dialog" aria-modal="true" aria-labelledby="gateTitle">
  <div class="gate-backdrop" data-gate-close></div>
  <form class="gate-card" data-lead-form data-kind="download" data-source="gate">
    <button type="button" class="gate-x" data-gate-close aria-label="<%= t("gate.close") %>">✕</button>
    <div class="kicker-gray" style="margin-bottom:8px"><%= t("gate.title") %></div>
    <h3 id="gateTitle" class="gate-title" data-gate-title></h3>
    <p class="gate-desc"><%= t("gate.desc") %></p>
    <input type="hidden" name="lead[download_key]" data-gate-key>
    <input type="text" name="mz_trap" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
    <input name="lead[name]" class="field" placeholder="<%= t("gate.name") %>" required>
    <input name="lead[phone]" class="field" placeholder="<%= t("gate.phone") %> / <%= t("gate.email") %>" inputmode="tel">
    <select name="lead[org_type]" class="field">
      <option value=""><%= t("gate.org_type") %></option>
      <% SiteData::ORG_TYPES.each do |k, v| %><option value="<%= k %>"><%= v %></option><% end %>
    </select>
    <button type="submit" class="form-btn"><%= t("gate.submit") %></button>
    <div class="form-msg" data-form-msg></div>
    <%# shown after the lead is saved; the link is the fallback if the automatic download is blocked %>
    <div class="gate-done" role="status">
      <div class="gate-done-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
      <h3 class="gate-title"><%= t("gate.done_h") %></h3>
      <p class="gate-desc"><%= t("gate.done_p") %></p>
      <a href="#" class="form-btn" data-gate-file target="_blank" rel="noopener" download><%= t("gate.done_cta") %></a>
    </div>
  </form>
</div>
