<%# Header: 5 primary items (IA doc §09 "نافيجيشن قصير"), mega menus, search, WhatsApp, RFQ CTA. %>
<% active = content_for(:nav_active).to_s %>
<header class="site-header">
  <a href="<%= root_path %>" class="logo-chip"><img src="/assets/logo.png" alt="<%= t("brand") %>"></a>

  <nav class="main-nav" aria-label="<%= t('nav.aria_main') %>">
    <%# ---- B2B ---- %>
    <div class="nav-item<%= ' current' if active == 'b2b' %>">
      <a href="<%= b2b_path %>"><%= t("nav.b2b") %></a>
      <div class="mega">
        <div class="mega-inner">
          <div class="mega-intro">
            <div class="mega-title"><%= t("nav.b2b") %></div>
            <p><%= t("nav.b2b_intro") %></p>
            <a href="<%= b2b_path %>" class="mega-cta"><%= t("home.paths.b2b_cta") %> ←</a>
          </div>
          <div class="mega-col">
            <div class="mega-head"><%= t("nav.custom_solutions") %></div>
            <% SiteData::SOLUTIONS.each do |s| %><a href="<%= solution_path(s[:slug]) %>"><%= s[:name] %></a><% end %>
          </div>
          <div class="mega-col">
            <div class="mega-head"><%= t("nav.projects") %></div>
            <% SiteData::PROJECTS.each do |p| %><a href="<%= project_path(p[:slug]) %>"><%= p[:name] %></a><% end %>
          </div>
          <div class="mega-col">
            <div class="mega-head"><%= t("nav.b2b") %></div>
            <a href="<%= solutions_path %>"><%= t("nav.custom_solutions") %></a>
            <a href="<%= projects_path %>"><%= t("nav.projects") %></a>
            <a href="<%= catalog_path %>"><%= t("nav.ecatalog") %></a>
            <a href="<%= rfq_path %>"><%= t("nav.rfq") %></a>
            <a href="<%= partners_path %>"><%= t("nav.partner") %></a>
          </div>
        </div>
      </div>
    </div>

    <%# ---- B2C ---- %>
    <div class="nav-item<%= ' current' if active == 'b2c' %>">
      <a href="<%= products_path %>"><%= t("nav.b2c") %></a>
      <div class="mega">
        <div class="mega-inner">
          <div class="mega-intro">
            <div class="mega-title"><%= t("nav.b2c") %></div>
            <p><%= t("nav.b2c_intro") %></p>
            <a href="<%= products_path %>" class="mega-cta"><%= t("nav.b2c_hub") %> ←</a>
          </div>
          <% SiteData::CATEGORIES.each_slice(2) do |pair| %>
          <div class="mega-col">
            <% pair.each do |c| %>
            <div class="mega-head"><a href="<%= product_category_path(c[:slug]) %>"><%= c[:name] %></a></div>
            <% c[:subcategories].each do |s| %><a href="<%= product_category_path(c[:slug], sub: s[:slug]) %>"><%= s[:name] %></a><% end %>
            <% end %>
          </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# ---- Quality & Safety ---- %>
    <div class="nav-item<%= ' current' if active == 'quality' %>">
      <a href="<%= quality_path %>"><%= t("nav.quality") %></a>
      <div class="mega mega-sm">
        <div class="mega-inner">
          <div class="mega-col">
            <div class="mega-head"><a href="<%= quality_path %>"><%= t("nav.quality_page") %></a></div>
            <% SiteData::CERTIFICATIONS.each do |c| %><a href="<%= quality_path %>#certifications"><%= c[:name] %></a><% end %>
            <a href="<%= quality_path %>#load-testing"><%= t("quality.load.label") %></a>
          </div>
          <div class="mega-col">
            <div class="mega-head"><a href="<%= safety_path %>"><%= t("nav.safety_page") %></a></div>
            <% SiteData::SAFETY.each do |a| %><a href="<%= safety_article_path(a[:slug]) %>"><%= a[:name] %></a><% end %>
            <a href="<%= safety_path %>#library"><%= t("nav.guides") %></a>
          </div>
          <div class="mega-col">
            <div class="mega-head"><a href="<%= original_path %>"><%= t("nav.original") %></a></div>
            <a href="<%= original_path %>#identify"><%= t("original.identify.h2") %></a>
            <a href="<%= original_path %>#verify"><%= t("original.verify.label") %></a>
          </div>
        </div>
      </div>
    </div>

    <%# ---- Company ---- %>
    <div class="nav-item<%= ' current' if active == 'company' %>">
      <a href="<%= about_path %>"><%= t("nav.company") %></a>
      <div class="mega mega-sm">
        <div class="mega-inner">
          <div class="mega-col">
            <div class="mega-head"><%= t("nav.company") %></div>
            <a href="<%= about_path %>"><%= t("nav.about") %></a>
            <a href="<%= projects_path %>"><%= t("nav.projects") %></a>
            <a href="<%= partners_path %>"><%= t("nav.partner") %></a>
            <a data-gate="company-profile" href="<%= download_path("company-profile") %>"><%= t("about.profile.cta") %></a>
          </div>
          <div class="mega-col">
            <div class="mega-head"><a href="<%= news_path %>"><%= t("nav.news") %></a></div>
            <% SiteData::TOPICS.each do |key, label| %><a href="<%= news_path(topic: key) %>"><%= label %></a><% end %>
          </div>
        </div>
      </div>
    </div>

    <%# ---- Contact ---- %>
    <div class="nav-item<%= ' current' if active == 'contact' %>">
      <a href="<%= contact_path %>"><%= t("nav.contact") %></a>
      <div class="mega mega-sm">
        <div class="mega-inner">
          <div class="mega-col">
            <div class="mega-head"><%= t("nav.departments") %></div>
            <% SiteData::DEPARTMENTS.each do |d| %><a href="<%= contact_path(dept: d[:key]) %>#form"><%= d[:name] %></a><% end %>
          </div>
          <div class="mega-col">
            <div class="mega-head"><%= t("nav.contact") %></div>
            <a href="<%= rfq_path %>"><%= t("nav.rfq") %></a>
            <a href="<%= contact_path %>#form"><%= t("contact.form.label") %></a>
            <a data-wa href="#"><%= t("common.whatsapp") %></a>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <div class="header-tools">
    <form action="<%= search_path %>" method="get" class="search-form" role="search">
      <input type="search" name="q" class="search-input" placeholder="<%= t("common.search_placeholder") %>" aria-label="<%= t("common.search") %>" value="<%= params[:q] if controller_name == 'search' %>">
      <button type="submit" class="search-btn" aria-label="<%= t("common.search") %>">⌕</button>
    </form>
    <a data-wa class="wa-pill" href="#"><%= render "shared/wa_icon", size: 16, color: "#25D366" %><span dir="ltr" style="unicode-bidi:isolate" data-wa-display></span></a>
    <a href="<%= rfq_path %>" class="btn-quote"><%= t("common.request_quote") %></a>
    <a class="lang-pill" href="<%= switch_locale_path %>" title="<%= t("nav.lang_soon") %>" hreflang="<%= I18n.locale == :en ? "ar" : "en" %>"><%= t("nav.lang_en") %></a>
    <button class="menu-btn" aria-label="<%= t('nav.aria_menu') %>" aria-expanded="false">☰</button>
  </div>
</header>

<nav class="mobile-nav" aria-label="<%= t('nav.aria_mobile') %>">
  <form action="<%= search_path %>" method="get" class="search-form mobile-search" role="search">
    <input type="search" name="q" class="search-input" placeholder="<%= t("common.search_placeholder") %>">
    <button type="submit" class="search-btn" aria-label="<%= t("common.search") %>">⌕</button>
  </form>
  <details<%= ' open' if active == 'b2b' %>><summary><%= t("nav.b2b") %></summary>
    <a href="<%= b2b_path %>"><%= t("home.paths.b2b_cta") %></a>
    <a href="<%= solutions_path %>"><%= t("nav.custom_solutions") %></a>
    <a href="<%= projects_path %>"><%= t("nav.projects") %></a>
    <a href="<%= catalog_path %>"><%= t("nav.ecatalog") %></a>
    <a href="<%= rfq_path %>"><%= t("nav.rfq") %></a>
    <a href="<%= partners_path %>"><%= t("nav.partner") %></a>
  </details>
  <details<%= ' open' if active == 'b2c' %>><summary><%= t("nav.b2c") %></summary>
    <a href="<%= products_path %>"><%= t("nav.b2c_hub") %></a>
    <% SiteData::CATEGORIES.each do |c| %><a href="<%= product_category_path(c[:slug]) %>"><%= c[:name] %></a><% end %>
  </details>
  <details<%= ' open' if active == 'quality' %>><summary><%= t("nav.quality") %></summary>
    <a href="<%= quality_path %>"><%= t("nav.quality_page") %></a>
    <a href="<%= safety_path %>"><%= t("nav.safety_page") %></a>
    <a href="<%= original_path %>"><%= t("nav.original") %></a>
  </details>
  <details<%= ' open' if active == 'company' %>><summary><%= t("nav.company") %></summary>
    <a href="<%= about_path %>"><%= t("nav.about") %></a>
    <a href="<%= news_path %>"><%= t("nav.news") %></a>
    <a href="<%= projects_path %>"><%= t("nav.projects") %></a>
  </details>
  <a href="<%= contact_path %>" class="mobile-link"><%= t("nav.contact") %></a>
  <a href="<%= rfq_path %>" class="mobile-link strong"><%= t("common.request_quote") %></a>
  <a href="<%= switch_locale_path %>" class="mobile-link"><%= t("nav.lang_en") %></a>
</nav>
