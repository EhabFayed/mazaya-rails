<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title><%= content_for(:title) || "لوحة التحكم" %> — مزايا</title>
<link rel="icon" type="image/png" href="/assets/logo.png">
<link rel="stylesheet" href="/site.css?v=20261112e">
<link rel="stylesheet" href="/admin.css?v=20261111b">
<%= csrf_meta_tags %>
</head>
<body class="adm">
<aside class="adm-side">
  <a href="<%= admin_root_path %>" class="adm-brand"><img src="/assets/logo-white.png" alt="مزايا"><span>لوحة التحكم</span></a>
  <%# Sidebar grouped by job: [group heading or nil, [[section key, label, path, permission area, icon, badge], ...]] %>
  <% nav = [
       [ nil, [
         [ "dashboard", "الرئيسية", admin_root_path, nil, :home ],
         [ "leads", "الطلبات الواردة", admin_leads_path, :leads, :inbox, Lead.unread.count ]
       ] ],
       [ "المنتجات والكتالوج", [
         [ "products", "المنتجات", admin_products_path, :content, :box ],
         [ "categories", "فئات المنتجات", admin_categories_path, :content, :grid ],
         [ "documents", "الكتالوجات والملفات", admin_documents_path, :content, :file ]
       ] ],
       [ "حلول الأعمال", [
         [ "solutions", "الحلول المخصصة", admin_solutions_path, :content, :tool ],
         [ "projects", "المشاريع", admin_projects_path, :content, :building ],
         [ "clients", "شعارات العملاء", admin_clients_path, :content, :star ]
       ] ],
       [ "محتوى الموقع", [
         [ "posts", "الأخبار والمقالات", admin_posts_path, :content, :news ],
         [ "safety_articles", "أدلة السلامة", admin_safety_articles_path, :content, :shield ],
         [ "translations", "نصوص الصفحات", admin_translations_path, :content, :type ],
         [ "content_lists", "أقسام الصفحات", admin_content_lists_path, :content, :list ]
       ] ],
       [ "الإعدادات", [
         [ "settings", "بيانات التواصل والإعدادات", admin_settings_path, :settings, :gear ],
         [ "departments", "أقسام التواصل", admin_departments_path, :content, :phone ],
         [ "users", "المستخدمون والصلاحيات", admin_users_path, :users, :users ]
       ] ]
     ] %>
  <nav class="adm-nav">
    <% nav.each do |heading, items| %>
      <% items = items.select { |_, _, _, area| area.nil? || can?(area) } %>
      <% next if items.empty? %>
      <% if heading %><div class="adm-nav-head"><%= heading %></div><% end %>
      <% items.each do |key, label, href, _area, icon, badge| %>
        <a href="<%= href %>" class="<%= 'active' if admin_section == key %>"><span class="adm-nav-label"><%= admin_icon(icon) %><%= label %></span><% if badge.to_i.positive? %><span class="badge" title="غير مقروء"><%= badge %></span><% end %></a>
      <% end %>
    <% end %>
  </nav>
  <div class="adm-user">
    <div><strong><%= current_user.name %></strong><br><span><%= { "admin" => "مدير", "editor" => "محرر", "sales" => "مبيعات" }[current_user.role] %></span></div>
    <div style="display:flex;gap:10px;flex-wrap:wrap"><a href="<%= edit_admin_user_path(current_user) %>">حسابي</a><a href="<%= root_path %>" target="_blank" rel="noopener">الموقع ↗</a><%= button_to "خروج", admin_logout_path, method: :delete, class: "linkbtn" %></div>
  </div>
</aside>
<main class="adm-main">
  <% if notice %><div class="flash ok"><%= notice %></div><% end %>
  <% if alert %><div class="flash err"><%= alert %></div><% end %>
  <%= yield %>
</main>
<script src="/admin.js"></script>
</body>
</html>
