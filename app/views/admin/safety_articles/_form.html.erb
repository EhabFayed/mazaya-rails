<%= errors_for(article) %>
<%= form_with model: [ :admin, article ], local: true, id: "safety-article-form" do |f| %>
  <div class="section">
    <h2>البيانات الأساسية</h2>
    <div class="stack">
      <%= bi_field(f, :name, "اسم الدليل", required: true) %>
      <div class="form-grid">
        <div>
          <label class="field-label">الرابط (slug)</label>
          <%= f.text_field :slug, class: "field sm", dir: "ltr", placeholder: "ladder-safety", data: { slug_target: true } %>
          <div class="hint">يُولّد تلقائيًا من الاسم لو تركته فارغًا.</div>
        </div>
      </div>
      <%= bi_field(f, :summary, "الملخص", type: :text_area, hint: "يظهر في كارت الدليل وأول صفحته.") %>
    </div>
  </div>

  <%= rows_editor("safety_article", :points, article.points, [ [ "title_ar", "العنوان (عربي)", :text ], [ "title_en", "العنوان (EN)", :text ], [ "desc_ar", "الوصف (عربي)", :textarea ], [ "desc_en", "الوصف (EN)", :textarea ] ], title: "نقاط السلامة", hint: "بلوكات عنوان + وصف.") %>
  <%= rows_editor("safety_article", :checklist, article.checklist, [ [ "text_ar", "النص (عربي)", :text ], [ "text_en", "النص (EN)", :text ] ], title: "قائمة الفحص قبل الاستخدام", hint: "نقاط قصيرة تظهر كـ checklist.") %>

  <div class="section">
    <h2>المنتجات المرتبطة</h2>
    <%= f.select :related_slugs, @products.map { |p| [ "#{p.name_ar} (#{p.category&.name_ar})", p.slug ] }, { selected: article.related_slugs }, multiple: true, class: "field sm", size: [ @products.size, 8 ].min.clamp(3, 8) %>
    <div class="hint">اضغط Ctrl/⌘ لاختيار أكثر من منتج. تظهر أسفل صفحة الدليل.</div>
  </div>

  <div class="section">
    <h2>النشر</h2>
    <div class="form-grid">
      <div>
        <label class="field-label">الترتيب</label>
        <%= f.number_field :position, class: "field sm", dir: "ltr" %>
        <div class="hint">الأصغر يظهر أولًا (يحدد رقم الخطوة).</div>
      </div>
      <div>
        <label class="field-label">الحالة</label>
        <label style="display:flex;gap:8px;align-items:center;font-size:14.5px"><%= f.check_box :published %> منشور في الموقع</label>
      </div>
    </div>
  </div>
<% end %>

<div class="sticky-actions">
  <button type="submit" form="safety-article-form" class="btn-navy sm">حفظ</button>
  <a href="<%= admin_safety_articles_path %>" class="btn-outline sm">إلغاء</a>
  <% if article.persisted? %>
    <span style="flex:1"></span>
    <%= button_to "حذف الدليل", admin_safety_article_path(article), method: :delete, class: "btn-danger", form: { data: { turbo: false }, style: "margin:0" }, data: { confirm: "حذف الدليل \"#{article.name_ar}\" نهائيًا؟" } %>
  <% end %>
</div>
