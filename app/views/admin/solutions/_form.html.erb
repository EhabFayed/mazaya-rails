<%= errors_for(solution) %>
<%= form_with model: [ :admin, solution ], local: true, multipart: true, id: "solution-form" do |f| %>
  <div class="section">
    <h2>البيانات الأساسية</h2>
    <p class="sub">الاسم بالعربي إجباري؛ الإنجليزي يظهر في النسخة الإنجليزية وكعنوان فرعي.</p>
    <div class="stack">
      <%= bi_field(f, :name, "اسم الحل", required: true) %>
      <div class="form-grid">
        <div>
          <label class="field-label">الرابط (slug)</label>
          <%= f.text_field :slug, class: "field sm", dir: "ltr", placeholder: "custom-ladders", data: { slug_target: true } %>
          <div class="hint">أحرف لاتينية صغيرة وأرقام وشرطات. يُولّد تلقائيًا من الاسم لو تركته فارغًا.</div>
        </div>
        <div>
          <label class="field-label">الفئة المرتبطة</label>
          <%= f.collection_select :category_id, @categories, :id, :name_ar, { include_blank: "— بدون فئة —" }, class: "field sm" %>
          <div class="hint">تحدد قسم المنتجات الجاهزة المعروض أسفل صفحة الحل.</div>
        </div>
      </div>
      <%= bi_field(f, :desc, "وصف الحل", type: :text_area, hint: "يُستخدم في هيرو صفحة الحل ووصف الصفحة لمحركات البحث.") %>
    </div>
  </div>

  <div class="section">
    <h2>الصورة والمشاريع</h2>
    <div class="form-grid">
      <div>
        <label class="field-label">صورة الحل</label>
        <div class="images" style="margin-bottom:10px">
          <% if solution.image.attached? %>
            <div class="img-card"><%= image_tag rails_representation_path(solution.image.variant(resize_to_fill: [ 300, 220 ]), only_path: true), alt: solution.name_ar %><div class="body"><span style="color:#686B70"><%= solution.image.filename %></span></div></div>
          <% end %>
          <div id="solution-image-preview" style="display:flex;gap:8px;flex-wrap:wrap"></div>
        </div>
        <%= f.file_field :image, accept: "image/*", class: "field sm", data: { preview: "#solution-image-preview" } %>
        <div class="hint">اختيار صورة جديدة يستبدل الحالية عند الحفظ.</div>
      </div>
      <div>
        <label class="field-label">المشاريع المرتبطة</label>
        <%= f.collection_select :project_ids, @projects, :id, :name_ar, {}, multiple: true, class: "field sm", size: [ @projects.size, 8 ].min.clamp(3, 8) %>
        <div class="hint">اضغط Ctrl/⌘ لاختيار أكثر من مشروع. تظهر في قسم "مشاريع مرتبطة" بصفحة الحل.</div>
      </div>
    </div>
  </div>

  <div class="section">
    <h2>النشر</h2>
    <div class="form-grid">
      <div>
        <label class="field-label">الترتيب</label>
        <%= f.number_field :position, class: "field sm", dir: "ltr" %>
        <div class="hint">الأصغر يظهر أولًا.</div>
      </div>
      <div>
        <label class="field-label">الحالة</label>
        <label style="display:flex;gap:8px;align-items:center;font-size:14.5px"><%= f.check_box :published %> منشور في الموقع</label>
      </div>
    </div>
  </div>

<% end %>

<div class="sticky-actions">
  <button type="submit" form="solution-form" class="btn-navy sm">حفظ</button>
  <a href="<%= admin_solutions_path %>" class="btn-outline sm">إلغاء</a>
  <% if solution.persisted? %>
    <span style="flex:1"></span>
    <%= button_to "حذف الحل", admin_solution_path(solution), method: :delete, class: "btn-danger", form: { data: { turbo: false }, style: "margin:0" }, data: { confirm: "حذف الحل \"#{solution.name_ar}\" نهائيًا؟ لن تُحذف المشاريع المرتبطة." } %>
  <% end %>
</div>
