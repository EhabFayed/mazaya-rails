<%# locals: model_name, field, rows, cols ([[key, label, type], ...]), title, hint %>
<% cell = lambda do |i, col, value|
     key, label, type = col
     name = "#{model_name}[#{field}][#{i}][#{key}]"
     ltr = key.to_s.end_with?("_en") || %w[key url abbr value suffix code].include?(key.to_s)
     inner = case type
             when :textarea then text_area_tag(name, value, class: "field sm", rows: 2, placeholder: label, dir: (ltr ? "ltr" : nil))
             when :number   then number_field_tag(name, value, class: "field sm", placeholder: label, step: "any")
             else text_field_tag(name, value, class: "field sm", placeholder: label, dir: (ltr ? "ltr" : nil))
             end
     content_tag(:div) { safe_join([ content_tag(:div, label, class: "lang"), inner ]) }
   end %>
<div class="section" data-rows="<%= field %>">
  <h2><%= title %></h2>
  <% if hint %><p class="sub"><%= hint %></p><% end %>
  <div class="rows">
    <% rows.each_with_index do |row, i| %>
      <% row = row.to_h.stringify_keys %>
      <div class="row">
        <div class="cells"><% cols.each do |col| %><%= cell.call(i, col, row[col[0].to_s]) %><% end %></div>
        <div class="tools"><button type="button" data-up title="أعلى">↑</button><button type="button" data-down title="أسفل">↓</button><button type="button" data-del class="del" title="حذف">✕</button></div>
      </div>
    <% end %>
  </div>
  <template>
    <div class="row">
      <div class="cells"><% cols.each do |col| %><%= cell.call("__i__", col, nil) %><% end %></div>
      <div class="tools"><button type="button" data-up title="أعلى">↑</button><button type="button" data-down title="أسفل">↓</button><button type="button" data-del class="del" title="حذف">✕</button></div>
    </div>
  </template>
  <button type="button" class="addrow" data-add style="margin-top:10px">+ إضافة صف</button>
</div>
