<% content_for :title, "الإعدادات" %>
<div class="page-head">
  <div><h1>إعدادات الموقع</h1><p>بيانات التواصل والخريطة وزمن الرد على طلبات عرض السعر وإشعارات الطلبات. تظهر مباشرة في صفحات الموقع بعد الحفظ.</p></div>
</div>

<%= errors_for(@setting) %>
<%= form_with model: @setting, url: admin_settings_path, method: :patch, local: true do |f| %>
  <div class="section">
    <h2>واتساب والتواصل</h2>
    <p class="sub">تظهر في الهيدر والفوتر وصفحة تواصل وزر واتساب العائم.</p>
    <div class="form-grid">
      <div>
        <%= f.label :whatsapp_display, "رقم واتساب (كما يُعرض)", class: "field-label" %>
        <%= f.text_field :whatsapp_display, class: "field sm", dir: "ltr", placeholder: "+966 50 000 0000" %>
        <div class="hint">مثال: +966 50 000 0000</div>
      </div>
      <div>
        <%= f.label :whatsapp_number, "رقم واتساب (أرقام فقط)", class: "field-label" %>
        <%= f.text_field :whatsapp_number, class: "field sm", dir: "ltr", placeholder: "966500000000", inputmode: "numeric" %>
        <div class="hint">يُستخدم في رابط wa.me — أرقام فقط بدون + أو مسافات. إن تُرك فارغًا يُستخرج من الرقم المعروض.</div>
      </div>
      <div>
        <%= f.label :phone, "الهاتف", class: "field-label" %>
        <%= f.text_field :phone, class: "field sm", dir: "ltr", placeholder: "+966 11 000 0000" %>
      </div>
      <div>
        <%= f.label :email, "البريد الإلكتروني", class: "field-label" %>
        <%= f.email_field :email, class: "field sm", dir: "ltr", placeholder: "info@mazaya.com" %>
      </div>
    </div>
  </div>

  <div class="section">
    <h2>العنوان وساعات العمل</h2>
    <p class="sub">تظهر في صفحة تواصل والفوتر. اترك العربي فارغًا لإظهار «قيد التحديث».</p>
    <div class="stack">
      <%= bi_field f, :address, "العنوان", type: :text_area, rows: 3 %>
      <%= bi_field f, :hours, "ساعات العمل", type: :text_area, rows: 2, hint: "مثال: الأحد – الخميس، 8 ص – 5 م" %>
    </div>
  </div>

  <div class="section">
    <h2>الخريطة</h2>
    <p class="sub">خريطة Google Maps في صفحة تواصل.</p>
    <%= f.label :map_embed, "رابط التضمين (Embed)", class: "field-label" %>
    <%= f.text_area :map_embed, class: "field sm", dir: "ltr", rows: 3, placeholder: "https://www.google.com/maps/embed?pb=…" %>
    <div class="hint">الصق رابط src من Google Maps → مشاركة → تضمين خريطة. لو لصقت كود &lt;iframe&gt; كاملًا سنستخرج الرابط تلقائيًا.</div>
    <% if @setting.map_embed.present? %>
      <div style="margin-top:14px;border-radius:12px;overflow:hidden;border:1px solid var(--line)"><iframe src="<%= @setting.map_embed %>" title="معاينة الخريطة" loading="lazy" style="width:100%;height:220px;border:0;display:block"></iframe></div>
    <% end %>
  </div>

  <div class="section">
    <h2>طلبات عرض السعر</h2>
    <p class="sub">يظهر في صفحة طلب عرض السعر تحت «ماذا بعد الإرسال؟».</p>
    <%= bi_field f, :rfq_response, "زمن الرد المتوقع", hint: "مثال: خلال يوم عمل واحد / Within one business day" %>
  </div>

  <div class="section">
    <h2>الإشعارات</h2>
    <p class="sub">من يستقبل بريدًا عند وصول أي طلب جديد (عرض سعر، شراكة، تحميل، تواصل).</p>
    <%= f.label :notify_emails, "بريد الإشعارات", class: "field-label" %>
    <%= f.text_area :notify_emails, class: "field sm", dir: "ltr", rows: 2, placeholder: "sales@mazaya.com, export@mazaya.com" %>
    <div class="hint">عناوين مفصولة بفاصلة. تستقبل إيميل بكل طلب جديد يصل من الموقع. لو تُركت فارغة يُستخدم الإعداد الافتراضي من الخادم (LEADS_NOTIFY_TO).</div>
  </div>

  <div class="section">
    <h2>معلومات عامة</h2>
    <div class="form-grid">
      <div>
        <%= f.label :founded, "سنة التأسيس", class: "field-label" %>
        <%= f.number_field :founded, class: "field sm", dir: "ltr", min: 1900, max: Date.current.year %>
        <div class="hint">تُستخدم في حساب «سنوات الخبرة» في الموقع.</div>
      </div>
    </div>
  </div>

  <div class="sticky-actions">
    <%= f.submit "حفظ الإعدادات", class: "btn-navy sm", name: nil %>
    <a href="<%= admin_root_path %>" class="btn-outline sm">إلغاء</a>
  </div>
<% end %>
