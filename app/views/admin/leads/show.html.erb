<% content_for :title, "طلب ##{@lead.id}" %>
<a href="<%= admin_leads_path %>" style="font-weight:700">← كل الطلبات</a>
<div style="display:flex;align-items:center;gap:14px;margin:14px 0 22px;flex-wrap:wrap">
  <h1 style="margin:0;color:#192C7B;font-size:28px;font-weight:900">#<%= @lead.id %> · <%= @lead.name %></h1>
  <span class="kind kind-<%= @lead.kind %>"><%= LeadMailer::KIND_LABELS[@lead.kind] %></span>
  <span style="color:#686B70;font-size:14px" dir="ltr"><%= @lead.created_at.strftime("%Y-%m-%d %H:%M") %></span>
</div>

<div class="grid-2" style="align-items:start">
  <div class="adm-card">
    <h2>بيانات التواصل</h2>
    <dl class="kv">
      <dt>الاسم</dt><dd><%= @lead.name %></dd>
      <dt>الجوال</dt><dd dir="ltr" style="text-align:end"><%= @lead.phone.presence || "—" %></dd>
      <dt>البريد</dt><dd dir="ltr" style="text-align:end"><%= @lead.email.presence || "—" %></dd>
      <dt>نوع الجهة</dt><dd><%= SiteData::ORG_TYPES[@lead.org_type] || @lead.org_type.presence || "—" %></dd>
      <dt>الاهتمام</dt><dd><%= @lead.interest.presence || "—" %></dd>
      <dt>الملف المطلوب</dt><dd><%= @lead.download_key.presence || "—" %></dd>
      <dt>المصدر</dt><dd><%= @lead.source %></dd>
    </dl>
    <div style="display:flex;gap:10px;margin-top:20px;flex-wrap:wrap">
      <% if @lead.phone.present? %><a href="https://wa.me/<%= @lead.phone.delete('^0-9') %>" target="_blank" rel="noopener" class="btn-wa" style="padding:10px 18px;font-size:14px">واتساب</a><a href="tel:<%= @lead.phone %>" class="btn-outline" style="padding:9px 18px;font-size:14px">اتصال</a><% end %>
      <% if @lead.email.present? %><a href="mailto:<%= @lead.email %>" class="btn-outline" style="padding:9px 18px;font-size:14px">إيميل</a><% end %>
    </div>
  </div>
  <div style="display:grid;gap:18px">
    <% if @lead.message.present? %><div class="adm-card"><h2>الرسالة</h2><p style="margin:0;white-space:pre-wrap;line-height:1.8"><%= @lead.message %></p></div><% end %>
    <% if @lead.payload.present? %>
    <div class="adm-card">
      <h2>تفاصيل النموذج</h2>
      <dl class="kv"><% @lead.payload.each do |k, v| %><% next if v.blank? %><dt><%= k %></dt><dd><%= v %></dd><% end %></dl>
    </div>
    <% end %>
    <div class="adm-card">
      <h2>المرفقات</h2>
      <% if @lead.files.attached? %>
        <ul style="margin:0;padding:0;list-style:none;display:grid;gap:8px">
          <% @lead.files.each do |f| %><li><a href="<%= rails_blob_path(f, disposition: "attachment") %>"><%= f.filename %></a> <span style="color:#9AA0A8;font-size:13px">(<%= number_to_human_size(f.byte_size) %>)</span></li><% end %>
        </ul>
      <% else %><p style="margin:0;color:#686B70">لا توجد مرفقات.</p><% end %>
    </div>
  </div>
</div>
