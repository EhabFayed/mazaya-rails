<% content_for :title, t("news.title") %>
<% content_for :description, t("news.description") %>
<% content_for :nav_active, "company" %>
<style>
  .bg-white .post-card{border:1px solid #E6E8EC}
  .featured-card{background:#fff;border-radius:26px;overflow:hidden;display:grid;grid-template-columns:1.1fr .9fr;box-shadow:0 18px 50px rgba(25,44,123,.1)}
  .featured-card .featured-media{min-height:380px;position:relative;background:#E9EBF0}
  .featured-card .featured-media .tag{position:absolute;top:18px;inset-inline-start:18px}
  .featured-card .featured-body{padding:44px 48px;display:flex;flex-direction:column;justify-content:center}
  .featured-card h3{margin:0 0 14px;color:#192C7B;font-size:32px;font-weight:900;line-height:1.3}
  .featured-card p{margin:0 0 28px;color:#686B70;font-size:16.5px;line-height:1.8}
  @media (max-width:960px){.featured-card{grid-template-columns:1fr}.featured-card .featured-media{min-height:240px}.featured-card .featured-body{padding:28px 24px}.featured-card h3{font-size:24px}}
</style>

<%# 01 — Hero %>
<%= render "shared/page_hero",
      label: t("news.hero.label"), h1: t("news.hero.h1"), desc: t("news.hero.desc"),
      crumbs: [ [ t("nav.company"), about_path ], [ t("nav.news"), nil ] ] %>

<%# 02 — Featured %>
<% if @featured %>
<section class="section-pad bg-white">
  <div class="wrap">
    <%= render "shared/section_head", label: t("news.featured.label"), h2: t("news.featured.h2") %>
    <div data-reveal class="featured-card card-hover">
      <div class="featured-media">
        <% if @featured[:image] %><img src="<%= @featured[:image] %>" alt="" class="cover" loading="lazy"><% else %><div class="ph-slot"><%= @featured[:category] %></div><% end %>
        <span class="tag"><%= @featured[:category] %></span>
      </div>
      <div class="featured-body">
        <div class="post-meta" style="margin-bottom:12px"><span class="post-cat"><%= @featured[:category] %></span><% if @featured[:date] %><span>·</span><span><%= @featured[:date] %></span><% end %></div>
        <h3><%= @featured[:title] %></h3>
        <p><%= @featured[:excerpt] %></p>
        <a href="<%= news_post_path(@featured[:slug]) %>" class="btn-navy" style="align-self:start"><%= t("common.read_more") %></a>
      </div>
    </div>
  </div>
</section>
<% end %>

<%# 03 — Latest news %>
<section class="section-pad bg-soft">
  <div class="wrap">
    <%= render "shared/section_head", label: t("news.latest.label"), h2: t("news.latest.h2") %>
    <div class="grid-3">
      <% @news.each do |n| %><%= render "shared/post_card", post: n %><% end %>
    </div>
  </div>
</section>

<%# 04 — Articles %>
<section class="section-pad bg-white">
  <div class="wrap">
    <%= render "shared/section_head", label: t("news.articles.label"), h2: t("news.articles.h2"), desc: t("news.articles.desc") %>
    <div class="grid-3">
      <% @articles.each do |a| %><%= render "shared/post_card", post: a %><% end %>
    </div>
  </div>
</section>

<%# 05 — Browse by topic %>
<section id="topics" class="section-pad bg-soft">
  <div class="wrap">
    <%= render "shared/section_head", label: t("news.topics.label"), h2: t("news.topics.h2") %>
    <div data-reveal class="filters">
      <a class="filter<%= ' active' if @topic.nil? %>" href="<%= news_path %>#topics"><%= t("common.all") %></a>
      <% @topics.each do |key, label| %>
      <a class="filter<%= ' active' if @topic == key %>" href="<%= news_path(topic: key) %>#topics"><%= label %></a>
      <% end %>
    </div>
    <% if @topic %>
      <% if @posts.any? %>
      <div class="grid-3">
        <% @posts.each do |p| %><%= render "shared/post_card", post: p %><% end %>
      </div>
      <% else %>
      <div data-reveal class="feature-card" style="text-align:center;color:#686B70;font-weight:700"><%= t("common.pending") %></div>
      <% end %>
    <% end %>
  </div>
</section>

<%# 06 — Final CTA %>
<%= render "shared/cta_band",
      label: t("news.final.label"), h2: t("news.final.h2"), desc: t("news.final.desc"),
      primary: [ t("common.explore_products"), products_path ], secondary: [ t("common.contact_us"), contact_path ] %>
