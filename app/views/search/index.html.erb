<% content_for :title, t("search.title") %>
<% content_for :description, t("search.description") %>
<style>
  .search-hero-form{height:60px;max-width:680px;padding:0 8px 0 6px;background:#fff;border-color:#fff;box-shadow:0 18px 50px rgba(0,0,0,.25);margin-top:28px}
  .search-hero-form .search-input{flex:1;width:auto;font-size:17px;padding:0 16px}
  .search-hero-form .search-input:focus{width:auto}
  .search-hero-form .search-btn{width:46px;height:46px;font-size:20px}
  .result-card{gap:10px}
  .result-card h3{margin:0}
  .result-card .chip{align-self:flex-start;background:#192C7B;color:#fff}
</style>

<%# 01 — Dark hero with search form %>
<section class="page-hero">
  <div class="page-hero-glow"></div>
  <div class="wrap" style="position:relative">
    <div data-reveal class="crumb"><a href="<%= root_path %>"><%= t("common.home") %></a><span class="crumb-sep">/</span><span><%= t("common.search") %></span></div>
    <div data-reveal class="kicker"><%= t("common.search") %></div>
    <h1 data-reveal><%= t("search.h1") %></h1>
    <form data-reveal action="<%= search_path %>" method="get" class="search-form search-hero-form" role="search">
      <input type="search" name="q" value="<%= @query %>" class="search-input" placeholder="<%= t("common.search_placeholder") %>" aria-label="<%= t("common.search") %>" autofocus>
      <button type="submit" class="search-btn" aria-label="<%= t("common.search") %>">⌕</button>
    </form>
  </div>
</section>

<%# 02 — Results %>
<section class="section-pad bg-soft" style="padding-top:64px">
  <div class="wrap">
    <% if @query.blank? %>
      <div data-reveal class="section-head" style="margin-bottom:0"><div><h2 style="font-size:30px"><%= t("search.prompt") %></h2></div></div>
    <% elsif @results.empty? %>
      <div data-reveal class="feature-card" style="text-align:center;align-items:center;padding:56px 28px">
        <h3 style="font-size:26px"><%= t("search.empty") %></h3>
        <p><%= t("search.hint") %></p>
        <div style="margin-top:22px;display:flex;gap:12px;flex-wrap:wrap;justify-content:center">
          <a href="<%= products_path %>" class="btn-navy"><%= t("common.explore_products") %></a>
          <a href="<%= solutions_path %>" class="btn-outline"><%= t("common.explore_solutions") %></a>
        </div>
      </div>
    <% else %>
      <div data-reveal class="section-head" style="margin-bottom:32px">
        <div><div class="kicker-gray"><%= t("search.h1") %></div><h2 style="font-size:30px"><%= t("search.results", count: (rtl? ? @results.size.to_s.tr('0-9', '٠-٩') : @results.size), query: @query) %></h2></div>
      </div>
      <div class="grid-2">
        <% @results.each do |r| %>
        <a href="<%= r[:url] %>" data-reveal class="feature-card card-hover result-card">
          <span class="chip"><%= r[:type] %></span>
          <h3><%= r[:title] %></h3>
          <% if r[:text].present? %><p><%= r[:text] %></p><% end %>
          <span class="card-link"><%= t("common.read_more") %> ←</span>
        </a>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<%# 03 — Category quick links %>
<section class="section-pad bg-white" style="padding-top:64px">
  <div class="wrap">
    <%= render "shared/section_head", label: t("b2c.categories.label"), h2: t("b2c.categories.h2"), center: true %>
    <div data-reveal class="tabs" style="justify-content:center">
      <% SiteData::CATEGORIES.each do |c| %><a href="<%= product_category_path(c[:slug]) %>" class="tab"><%= c[:name] %></a><% end %>
      <a href="<%= solutions_path %>" class="tab"><%= t("nav.custom_solutions") %></a>
      <a href="<%= safety_path %>" class="tab"><%= t("nav.safety_page") %></a>
    </div>
  </div>
</section>
